@model CoffeeShopManagement.Models.LoaiSanPham

@{
    ViewData["Title"] = "Sửa danh mục";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/admin-category.css"
          asp-append-version="true" />

}

<div class="admin-welcome">

    <div class="category-admin-heading">

        <div>

            <h2>
                Sửa danh mục
            </h2>

            <p>
                Cập nhật tên danh mục
                trong hệ thống Rosalie Coffee.
            </p>

        </div>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Index"
           class="category-back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Quay lại

        </a>

    </div>

</div>


<form asp-area="Admin"
      asp-controller="Category"
      asp-action="Edit"
      asp-route-id="@Model.MaLoai"
      method="post"
      class="category-form-card">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="MaLoai" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="category-form-group">

        <label asp-for="TenLoai">
            Tên danh mục
        </label>

        <input asp-for="TenLoai"
               class="category-form-control" />

        <span asp-validation-for="TenLoai"
              class="text-danger">
        </span>

    </div>

    <div class="category-form-actions">

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Index"
           class="category-cancel-btn">

            Hủy

        </a>

        <button type="submit"
                class="category-submit-btn">

            <i class="fa-solid fa-floppy-disk"></i>

            Lưu thay đổi

        </button>

    </div>

</form>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}