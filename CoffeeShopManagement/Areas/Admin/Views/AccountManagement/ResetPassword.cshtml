@model CoffeeShopManagement.Models.TaiKhoan

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/admin-account.css"
          asp-append-version="true" />

}


<div class="account-page">


    <div class="account-intro">

        <div class="account-intro-content">

            <span class="account-label">

                <i class="fa-solid fa-key"></i>

                ROSALIE COFFEE

            </span>

            <h2>
                Đặt lại mật khẩu
            </h2>

            <p>
                Thiết lập mật khẩu mới cho tài khoản
                <strong>@Model.TenDangNhap</strong>.
            </p>

        </div>


        <a asp-area="Admin"
           asp-controller="AccountManagement"
           asp-action="Index"
           class="account-reset-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Quay lại

        </a>

    </div>


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="account-alert account-alert-error">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @TempData["ErrorMessage"]
            </span>

        </div>
    }


    <div class="account-password-page">

        <div class="account-password-card">


            <div class="account-password-user">

                <div class="account-password-avatar">

                    @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
                    {
                        <img src="~/images/avatars/@Model.HinhAnh"
                             asp-append-version="true"
                             alt="@Model.HoTen" />
                    }
                    else
                    {
                        <i class="fa-solid fa-user"></i>
                    }

                </div>

                <div>

                    <strong>
                        @Model.HoTen
                    </strong>

                    <span>
                        @@ @Model.TenDangNhap
                    </span>

                </div>

            </div>


            <div class="account-password-warning">

                <i class="fa-solid fa-shield-halved"></i>

                <div>

                    <strong>
                        Thiết lập mật khẩu mới
                    </strong>

                    <span>
                        Mật khẩu hiện tại sẽ được thay thế.
                        Hệ thống không hiển thị hoặc lưu mật khẩu dạng văn bản.
                    </span>

                </div>

            </div>


            <form asp-area="Admin"
                  asp-controller="AccountManagement"
                  asp-action="ResetPassword"
                  asp-route-id="@Model.MaTaiKhoan"
                  method="post"
                  class="account-password-form">

                @Html.AntiForgeryToken()


                <div class="account-form-group">

                    <label for="newPassword">

                        Mật khẩu mới
                        <span>*</span>

                    </label>

                    <div class="account-form-control-wrap account-password-control">

                        <i class="fa-solid fa-lock"></i>

                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               minlength="6"
                               placeholder="Tối thiểu 6 ký tự"
                               required />

                        <button type="button"
                                class="account-password-toggle"
                                onclick="togglePassword('newPassword', this)">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                </div>


                <div class="account-form-group">

                    <label for="confirmPassword">

                        Xác nhận mật khẩu
                        <span>*</span>

                    </label>

                    <div class="account-form-control-wrap account-password-control">

                        <i class="fa-solid fa-shield"></i>

                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               minlength="6"
                               placeholder="Nhập lại mật khẩu mới"
                               required />

                        <button type="button"
                                class="account-password-toggle"
                                onclick="togglePassword('confirmPassword', this)">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                </div>


                <div id="passwordMatchMessage"
                     class="account-password-match"></div>


                <div class="account-form-actions">

                    <a asp-area="Admin"
                       asp-controller="AccountManagement"
                       asp-action="Index"
                       class="account-cancel-btn">

                        Hủy

                    </a>

                    <button type="submit"
                            class="account-submit-btn">

                        <i class="fa-solid fa-key"></i>

                        Đặt lại mật khẩu

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function togglePassword(
            inputId,
            button
        ) {

            const input =
                document.getElementById(
                    inputId
                );

            const icon =
                button.querySelector("i");

            if (!input || !icon) {
                return;
            }

            if (input.type === "password") {

                input.type = "text";

                icon.className =
                    "fa-regular fa-eye-slash";

            }
            else {

                input.type = "password";

                icon.className =
                    "fa-regular fa-eye";

            }

        }


        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const password =
                    document.getElementById(
                        "newPassword"
                    );

                const confirmPassword =
                    document.getElementById(
                        "confirmPassword"
                    );

                const message =
                    document.getElementById(
                        "passwordMatchMessage"
                    );


                function checkPasswordMatch() {

                    if (!confirmPassword.value) {

                        message.textContent = "";

                        message.className =
                            "account-password-match";

                        return;
                    }


                    if (password.value ===
                        confirmPassword.value) {

                        message.textContent =
                            "✓ Mật khẩu xác nhận đã khớp.";

                        message.className =
                            "account-password-match success";

                    }
                    else {

                        message.textContent =
                            "Mật khẩu xác nhận chưa khớp.";

                        message.className =
                            "account-password-match error";

                    }

                }


                password.addEventListener(
                    "input",
                    checkPasswordMatch
                );

                confirmPassword.addEventListener(
                    "input",
                    checkPasswordMatch
                );

            }
        );

    </script>

}