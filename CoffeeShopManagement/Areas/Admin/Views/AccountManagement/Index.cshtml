@using CoffeeShopManagement.Models
@using Microsoft.AspNetCore.Http

@model List<CoffeeShopManagement.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý tài khoản";

    var keyword =
        ViewBag.Keyword?.ToString() ?? "";

    int? roleId =
        ViewBag.RoleId as int?;

    var status =
        ViewBag.Status?.ToString() ?? "";

    var sort =
        ViewBag.Sort?.ToString() ?? "newest";

    int pageSize =
        ViewBag.PageSize ?? 10;

    int currentPage =
        ViewBag.CurrentPage ?? 1;

    int totalPages =
        ViewBag.TotalPages ?? 1;

    int totalFiltered =
        ViewBag.TotalFiltered ?? 0;

    int totalAccounts =
        ViewBag.TotalAccounts ?? 0;

    int activeAccounts =
        ViewBag.ActiveAccounts ?? 0;

    int lockedAccounts =
        ViewBag.LockedAccounts ?? 0;

    int adminAccounts =
        ViewBag.AdminAccounts ?? 0;

    var roles =
        ViewBag.Roles as List<VaiTro>
        ?? new List<VaiTro>();

    var currentAccountId =
        Context.Session.GetInt32(
            "AdminAccountId"
        );

    var currentRole =
        Context.Session.GetString(
            "AdminRole"
        ) ?? "";

    bool currentUserIsAdmin =
        currentRole.Equals(
            "Admin",
            StringComparison.OrdinalIgnoreCase
        );
}


@section Styles {

    <link rel="stylesheet"
          href="~/css/admin-account.css"
          asp-append-version="true" />

}


<div class="account-page">


    <!-- =====================================================
         SUCCESS TOAST
    ====================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="adminSuccessToast"
             class="admin-success-toast">

            <div class="admin-success-toast-icon">

                <i class="fa-solid fa-check"></i>

            </div>


            <div class="admin-success-toast-content">

                <strong>
                    Thành công
                </strong>

                <span>
                    @TempData["SuccessMessage"]
                </span>

            </div>


            <button type="button"
                    class="admin-success-toast-close"
                    onclick="closeAdminToast()"
                    aria-label="Đóng">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>
    }


    <!-- =====================================================
         ERROR TOAST
    ====================================================== -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div id="adminErrorToast"
             class="admin-error-toast">

            <div class="admin-error-toast-icon">

                <i class="fa-solid fa-triangle-exclamation"></i>

            </div>


            <div class="admin-error-toast-content">

                <strong>
                    Không thể thực hiện
                </strong>

                <span>
                    @TempData["ErrorMessage"]
                </span>

            </div>


            <button type="button"
                    class="admin-error-toast-close"
                    onclick="closeAdminErrorToast()"
                    aria-label="Đóng">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>
    }


    <!-- =====================================================
         INTRO
    ====================================================== -->

    <div class="account-intro account-intro-modern">

        <div class="account-intro-content">

            <span class="account-label">

                <i class="fa-solid fa-shield-halved"></i>

                ROSALIE COFFEE

            </span>


            <h2>
                Quản lý tài khoản hệ thống
            </h2>


            <p>
                Theo dõi, chỉnh sửa và quản lý quyền truy cập
                của các tài khoản đang sử dụng hệ thống Rosalie Coffee.
            </p>

        </div>


        <a asp-area="Admin"
           asp-controller="AccountManagement"
           asp-action="Create"
           class="account-create-btn">

            <i class="fa-solid fa-user-plus"></i>

            <span>
                Thêm tài khoản
            </span>

        </a>

    </div>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="account-stat-grid account-stat-grid-four">


        <!-- TOTAL -->

        <div class="account-stat-card">

            <div class="account-stat-icon">

                <i class="fa-solid fa-users"></i>

            </div>


            <div class="account-stat-info">

                <span>
                    Tổng tài khoản
                </span>

                <strong>
                    @totalAccounts
                </strong>

                <small>
                    Toàn bộ hệ thống
                </small>

            </div>

        </div>


        <!-- ACTIVE -->

        <div class="account-stat-card">

            <div class="account-stat-icon active">

                <i class="fa-solid fa-user-check"></i>

            </div>


            <div class="account-stat-info">

                <span>
                    Đang hoạt động
                </span>

                <strong>
                    @activeAccounts
                </strong>

                <small>
                    Có thể đăng nhập
                </small>

            </div>

        </div>


        <!-- LOCKED -->

        <div class="account-stat-card">

            <div class="account-stat-icon locked">

                <i class="fa-solid fa-user-lock"></i>

            </div>


            <div class="account-stat-info">

                <span>
                    Đã khóa
                </span>

                <strong>
                    @lockedAccounts
                </strong>

                <small>
                    Tạm ngừng truy cập
                </small>

            </div>

        </div>


        <!-- ADMIN -->

        <div class="account-stat-card">

            <div class="account-stat-icon admin-count">

                <i class="fa-solid fa-user-shield"></i>

            </div>


            <div class="account-stat-info">

                <span>
                    Quản trị viên
                </span>

                <strong>
                    @adminAccounts
                </strong>

                <small>
                    Tài khoản Admin
                </small>

            </div>

        </div>


    </div>


    <!-- =====================================================
         FILTER
    ====================================================== -->

    <div class="account-filter-card">


        <div class="account-filter-heading">

            <div>

                <span class="account-filter-label">
                    BỘ LỌC
                </span>

                <h3>
                    Tìm kiếm tài khoản
                </h3>

            </div>


            <div class="account-result-count">

                <i class="fa-solid fa-list"></i>

                <span>
                    Tìm thấy
                    <strong>@totalFiltered</strong>
                    tài khoản
                </span>

            </div>

        </div>


        <form asp-area="Admin"
              asp-controller="AccountManagement"
              asp-action="Index"
              method="get"
              class="account-filter-form">


            <!-- SEARCH -->

            <div class="account-filter-group account-filter-search">

                <label for="keyword">
                    Tìm kiếm
                </label>

                <div class="account-filter-control">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text"
                           id="keyword"
                           name="keyword"
                           value="@keyword"
                           placeholder="Tên đăng nhập, họ tên, email, số điện thoại..." />

                </div>

            </div>


            <!-- ROLE -->

            <div class="account-filter-group">

                <label for="roleId">
                    Vai trò
                </label>

                <div class="account-filter-control">

                    <i class="fa-solid fa-users-gear"></i>

                    <select id="roleId"
                            name="roleId">

                        <option value="">
                            Tất cả vai trò
                        </option>


                        @foreach (var role in roles)
                        {
                            if (roleId.HasValue &&
                                roleId.Value == role.MaVaiTro)
                            {
                                <option value="@role.MaVaiTro"
                                        selected>
                                    @role.TenVaiTro
                                </option>
                            }
                            else
                            {
                                <option value="@role.MaVaiTro">
                                    @role.TenVaiTro
                                </option>
                            }
                        }

                    </select>

                </div>

            </div>


            <!-- STATUS -->

            <div class="account-filter-group">

                <label for="status">
                    Trạng thái
                </label>

                <div class="account-filter-control">

                    <i class="fa-solid fa-circle-check"></i>

                    <select id="status"
                            name="status">


                        @if (string.IsNullOrWhiteSpace(status))
                        {
                            <option value=""
                                    selected>
                                Tất cả trạng thái
                            </option>
                        }
                        else
                        {
                            <option value="">
                                Tất cả trạng thái
                            </option>
                        }


                        @if (status == "active")
                        {
                            <option value="active"
                                    selected>
                                Đang hoạt động
                            </option>
                        }
                        else
                        {
                            <option value="active">
                                Đang hoạt động
                            </option>
                        }


                        @if (status == "locked")
                        {
                            <option value="locked"
                                    selected>
                                Đã khóa
                            </option>
                        }
                        else
                        {
                            <option value="locked">
                                Đã khóa
                            </option>
                        }

                    </select>

                </div>

            </div>


            <!-- SORT -->

            <div class="account-filter-group">

                <label for="sort">
                    Sắp xếp
                </label>

                <div class="account-filter-control">

                    <i class="fa-solid fa-arrow-down-wide-short"></i>

                    <select id="sort"
                            name="sort">


                        @if (sort == "newest")
                        {
                            <option value="newest"
                                    selected>
                                Mới nhất
                            </option>
                        }
                        else
                        {
                            <option value="newest">
                                Mới nhất
                            </option>
                        }


                        @if (sort == "oldest")
                        {
                            <option value="oldest"
                                    selected>
                                Cũ nhất
                            </option>
                        }
                        else
                        {
                            <option value="oldest">
                                Cũ nhất
                            </option>
                        }


                        @if (sort == "username_asc")
                        {
                            <option value="username_asc"
                                    selected>
                                Tài khoản A → Z
                            </option>
                        }
                        else
                        {
                            <option value="username_asc">
                                Tài khoản A → Z
                            </option>
                        }


                        @if (sort == "username_desc")
                        {
                            <option value="username_desc"
                                    selected>
                                Tài khoản Z → A
                            </option>
                        }
                        else
                        {
                            <option value="username_desc">
                                Tài khoản Z → A
                            </option>
                        }


                        @if (sort == "role")
                        {
                            <option value="role"
                                    selected>
                                Theo vai trò
                            </option>
                        }
                        else
                        {
                            <option value="role">
                                Theo vai trò
                            </option>
                        }

                    </select>

                </div>

            </div>


            <!-- PAGE SIZE -->

            <div class="account-filter-group account-filter-size">

                <label for="pageSize">
                    Hiển thị
                </label>

                <div class="account-filter-control">

                    <i class="fa-solid fa-table-list"></i>

                    <select id="pageSize"
                            name="pageSize">

                        @foreach (var size in new[] { 5, 10, 20, 50 })
                        {
                            if (pageSize == size)
                            {
                                <option value="@size"
                                        selected>
                                    @size dòng
                                </option>
                            }
                            else
                            {
                                <option value="@size">
                                    @size dòng
                                </option>
                            }
                        }

                    </select>

                </div>

            </div>


            <!-- ACTION -->

            <div class="account-filter-actions">

                <button type="submit"
                        class="account-search-btn">

                    <i class="fa-solid fa-filter"></i>

                    Áp dụng

                </button>


                <a asp-area="Admin"
                   asp-controller="AccountManagement"
                   asp-action="Index"
                   class="account-reset-btn">

                    <i class="fa-solid fa-rotate-left"></i>

                    Đặt lại

                </a>

            </div>


        </form>

    </div>


    <!-- =====================================================
         TABLE
    ====================================================== -->

    <div class="account-table-card account-table-card-modern">


        <div class="account-table-header account-table-header-modern">

            <div>

                <span class="account-table-label">
                    DANH SÁCH
                </span>

                <h3>
                    Tài khoản hệ thống
                </h3>

                <p>
                    Quản lý thông tin, vai trò, mật khẩu
                    và trạng thái của từng tài khoản.
                </p>

            </div>


            <div class="account-table-summary">

                Trang
                <strong>@currentPage</strong>
                /
                <strong>@totalPages</strong>

            </div>

        </div>


        <div class="account-table-wrapper">

            <table class="account-table account-table-modern">


                <thead>

                    <tr>

                        <th class="account-col-number">
                            #
                        </th>

                        <th>
                            Tài khoản
                        </th>

                        <th>
                            Họ và tên
                        </th>

                        <th>
                            Liên hệ
                        </th>

                        <th>
                            Vai trò
                        </th>

                        <th>
                            Trạng thái
                        </th>

                        <th>
                            Ngày tạo
                        </th>

                        <th class="account-action-heading">
                            Thao tác
                        </th>

                    </tr>

                </thead>


                <tbody>


                    @if (Model != null &&
                         Model.Any())
                    {
                        var index =
                            ((currentPage - 1) * pageSize) + 1;


                        foreach (var item in Model)
                        {
                            var roleName =
                                item.MaVaiTroNavigation?.TenVaiTro
                                ?? "Chưa xác định";


                            var isAdminRole =
                                roleName.Equals(
                                    "Admin",
                                    StringComparison.OrdinalIgnoreCase
                                );


                            var isStaffRole =
                                roleName.Equals(
                                    "Nhân viên",
                                    StringComparison.OrdinalIgnoreCase
                                );


                            var isCustomerRole =
                                roleName.Equals(
                                    "Khách hàng",
                                    StringComparison.OrdinalIgnoreCase
                                );


                            var isDeliveryRole =
                                roleName.Equals(
                                    "Giao hàng",
                                    StringComparison.OrdinalIgnoreCase
                                )
                                ||
                                roleName.Equals(
                                    "GiaoHang",
                                    StringComparison.OrdinalIgnoreCase
                                );


                            var roleCss =
                                isAdminRole
                                    ? "admin"
                                    : isStaffRole
                                        ? "staff"
                                        : isCustomerRole
                                            ? "customer"
                                            : isDeliveryRole
                                                ? "delivery"
                                                : "other";


                            var roleIcon =
                                isAdminRole
                                    ? "fa-user-shield"
                                    : isStaffRole
                                        ? "fa-user-tie"
                                        : isCustomerRole
                                            ? "fa-user"
                                            : isDeliveryRole
                                                ? "fa-truck-fast"
                                                : "fa-user-tag";


                            bool isCurrentAccount =
                                currentAccountId.HasValue &&
                                currentAccountId.Value ==
                                item.MaTaiKhoan;


                            bool canManageThisAccount =
                                currentUserIsAdmin ||
                                !isAdminRole;


                            <tr class="@(isCurrentAccount ? "account-current-row" : "")">


                                <!-- NUMBER -->

                                <td>

                                    <span class="account-number">
                                        @index
                                    </span>

                                </td>


                                <!-- ACCOUNT -->

                                <td>

                                    <div class="account-user">

                                        <div class="account-user-avatar">


                                            @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                                            {
                                                <img src="~/images/avatars/@item.HinhAnh"
                                                     asp-append-version="true"
                                                     alt="@item.HoTen"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                                <span class="account-avatar-fallback"
                                                      style="display:none;">

                                                    <i class="fa-solid @roleIcon"></i>

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="account-avatar-fallback">

                                                    <i class="fa-solid @roleIcon"></i>

                                                </span>
                                            }

                                        </div>


                                        <div class="account-user-info">


                                            <div class="account-user-name-line">

                                                <strong>
                                                    @item.TenDangNhap
                                                </strong>


                                                @if (isCurrentAccount)
                                                {
                                                    <span class="account-you-badge">
                                                        Bạn
                                                    </span>
                                                }

                                            </div>


                                            <span>
                                                ID: @item.MaTaiKhoan
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- FULL NAME -->

                                <td>

                                    <strong class="account-full-name">

                                        @item.HoTen

                                    </strong>

                                </td>


                                <!-- CONTACT -->

                                <td>

                                    <div class="account-contact">


                                        @if (!string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            <span title="@item.Email">

                                                <i class="fa-regular fa-envelope"></i>

                                                @item.Email

                                            </span>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(item.DienThoai))
                                        {
                                            <span>

                                                <i class="fa-solid fa-phone"></i>

                                                @item.DienThoai

                                            </span>
                                        }


                                        @if (
                                            string.IsNullOrWhiteSpace(item.Email)
                                            &&
                                            string.IsNullOrWhiteSpace(item.DienThoai)
                                        )
                                        {
                                            <span class="account-empty">

                                                <i class="fa-solid fa-minus"></i>

                                                Chưa cập nhật

                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- ROLE -->

                                <td>

                                    <span class="account-role @roleCss">

                                        <i class="fa-solid @roleIcon"></i>

                                        @roleName

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="account-status active">

                                            <span class="status-dot"></span>

                                            Hoạt động

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="account-status locked">

                                            <span class="status-dot"></span>

                                            Đã khóa

                                        </span>
                                    }

                                </td>


                                <!-- CREATED -->

                                <td>

                                    <div class="account-date">

                                        <i class="fa-regular fa-calendar"></i>

                                        <span>

                                            @item.NgayTao.ToString(
                                                "dd/MM/yyyy"
                                            )

                                        </span>

                                    </div>

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="account-actions">


                                        <!-- DETAILS -->

                                        <a asp-area="Admin"
                                           asp-controller="AccountManagement"
                                           asp-action="Details"
                                           asp-route-id="@item.MaTaiKhoan"
                                           class="account-action-btn view"
                                           title="Xem chi tiết">

                                            <i class="fa-regular fa-eye"></i>

                                        </a>


                                        @if (canManageThisAccount)
                                        {

                                            <!-- EDIT -->

                                            <a asp-area="Admin"
                                               asp-controller="AccountManagement"
                                               asp-action="Edit"
                                               asp-route-id="@item.MaTaiKhoan"
                                               class="account-action-btn edit"
                                               title="Chỉnh sửa">

                                                <i class="fa-solid fa-pen"></i>

                                            </a>


                                            <!-- RESET PASSWORD -->

                                            <a asp-area="Admin"
                                               asp-controller="AccountManagement"
                                               asp-action="ResetPassword"
                                               asp-route-id="@item.MaTaiKhoan"
                                               class="account-action-btn password"
                                               title="Đặt lại mật khẩu">

                                                <i class="fa-solid fa-key"></i>

                                            </a>


                                            <!-- LOCK / UNLOCK -->

                                            @if (!isCurrentAccount)
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="AccountManagement"
                                                      asp-action="ToggleStatus"
                                                      method="post"
                                                      onsubmit="return openToggleAccountModal(this, '@item.TenDangNhap', @item.IsActive.ToString().ToLower());">

                                                    @Html.AntiForgeryToken()


                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.MaTaiKhoan" />


                                                    @if (item.IsActive)
                                                    {
                                                        <button type="submit"
                                                                class="account-action-btn lock"
                                                                title="Khóa tài khoản">

                                                            <i class="fa-solid fa-lock"></i>

                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="account-action-btn unlock"
                                                                title="Mở khóa tài khoản">

                                                            <i class="fa-solid fa-lock-open"></i>

                                                        </button>
                                                    }

                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="account-action-btn disabled"
                                                        title="Không thể tự khóa tài khoản"
                                                        disabled>

                                                    <i class="fa-solid fa-lock"></i>

                                                </button>
                                            }

                                        }
                                        else
                                        {
                                            <span class="account-protected"
                                                  title="Tài khoản Admin được bảo vệ">

                                                <i class="fa-solid fa-shield"></i>

                                            </span>
                                        }

                                    </div>

                                </td>

                            </tr>


                            index++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8">

                                <div class="account-empty-state">

                                    <div class="account-empty-icon">

                                        <i class="fa-solid fa-user-slash"></i>

                                    </div>


                                    <h3>
                                        Không tìm thấy tài khoản
                                    </h3>


                                    <p>
                                        Không có tài khoản nào phù hợp
                                        với điều kiện tìm kiếm hiện tại.
                                    </p>


                                    <a asp-area="Admin"
                                       asp-controller="AccountManagement"
                                       asp-action="Index">

                                        <i class="fa-solid fa-rotate-left"></i>

                                        Đặt lại bộ lọc

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }


                </tbody>

            </table>

        </div>


        <!-- =================================================
             PAGINATION
        ================================================== -->

        @if (totalPages > 1)
        {
            <div class="account-pagination-wrap">


                <div class="account-pagination-info">

                    Trang
                    <strong>@currentPage</strong>
                    trên
                    <strong>@totalPages</strong>

                </div>


                <div class="account-pagination">


                    <!-- PREVIOUS -->

                    @if (currentPage > 1)
                    {
                        <a asp-area="Admin"
                           asp-controller="AccountManagement"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-roleId="@roleId"
                           asp-route-status="@status"
                           asp-route-sort="@sort"
                           asp-route-pageSize="@pageSize"
                           asp-route-page="@(currentPage - 1)"
                           class="account-page-btn">

                            <i class="fa-solid fa-chevron-left"></i>

                        </a>
                    }
                    else
                    {
                        <span class="account-page-btn disabled">

                            <i class="fa-solid fa-chevron-left"></i>

                        </span>
                    }


                    @{
                        var startPage =
                            Math.Max(
                                1,
                                currentPage - 2
                            );

                        var endPage =
                            Math.Min(
                                totalPages,
                                currentPage + 2
                            );
                    }


                    @if (startPage > 1)
                    {
                        <a asp-area="Admin"
                           asp-controller="AccountManagement"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-roleId="@roleId"
                           asp-route-status="@status"
                           asp-route-sort="@sort"
                           asp-route-pageSize="@pageSize"
                           asp-route-page="1"
                           class="account-page-btn">

                            1

                        </a>


                        @if (startPage > 2)
                        {
                            <span class="account-page-dots">
                                ...
                            </span>
                        }
                    }


                    @for (
                        var i = startPage;
                        i <= endPage;
                        i++
                    )
                    {
                        if (i == currentPage)
                        {
                            <span class="account-page-btn active">
                                @i
                            </span>
                        }
                        else
                        {
                            <a asp-area="Admin"
                               asp-controller="AccountManagement"
                               asp-action="Index"
                               asp-route-keyword="@keyword"
                               asp-route-roleId="@roleId"
                               asp-route-status="@status"
                               asp-route-sort="@sort"
                               asp-route-pageSize="@pageSize"
                               asp-route-page="@i"
                               class="account-page-btn">

                                @i

                            </a>
                        }
                    }


                    @if (endPage < totalPages)
                    {

                        @if (endPage < totalPages - 1)
                        {
                            <span class="account-page-dots">
                                ...
                            </span>
                        }


                        <a asp-area="Admin"
                           asp-controller="AccountManagement"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-roleId="@roleId"
                           asp-route-status="@status"
                           asp-route-sort="@sort"
                           asp-route-pageSize="@pageSize"
                           asp-route-page="@totalPages"
                           class="account-page-btn">

                            @totalPages

                        </a>
                    }


                    <!-- NEXT -->

                    @if (currentPage < totalPages)
                    {
                        <a asp-area="Admin"
                           asp-controller="AccountManagement"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-roleId="@roleId"
                           asp-route-status="@status"
                           asp-route-sort="@sort"
                           asp-route-pageSize="@pageSize"
                           asp-route-page="@(currentPage + 1)"
                           class="account-page-btn">

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <span class="account-page-btn disabled">

                            <i class="fa-solid fa-chevron-right"></i>

                        </span>
                    }


                </div>

            </div>
        }


    </div>

</div>


<!-- =====================================================
     CUSTOM CONFIRM MODAL
====================================================== -->

<div id="accountConfirmModal"
     class="account-confirm-modal"
     aria-hidden="true">


    <div class="account-confirm-backdrop"
         onclick="closeToggleAccountModal()">
    </div>


    <div class="account-confirm-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="accountConfirmTitle">


        <!-- CLOSE -->

        <button type="button"
                class="account-confirm-close"
                onclick="closeToggleAccountModal()"
                aria-label="Đóng">

            <i class="fa-solid fa-xmark"></i>

        </button>


        <!-- ICON -->

        <div id="accountConfirmIcon"
             class="account-confirm-icon danger">

            <i class="fa-solid fa-user-lock"></i>

        </div>


        <span class="account-confirm-label">
            ROSALIE COFFEE
        </span>


        <h3 id="accountConfirmTitle">
            Xác nhận thao tác
        </h3>


        <p id="accountConfirmMessage">

            Bạn có chắc muốn thực hiện thao tác này?

        </p>


        <!-- ACCOUNT INFO -->

        <div class="account-confirm-account">

            <div class="account-confirm-user-icon">

                <i class="fa-solid fa-user"></i>

            </div>


            <div>

                <span>
                    Tài khoản
                </span>

                <strong id="accountConfirmUsername">
                    ---
                </strong>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="account-confirm-actions">


            <button type="button"
                    class="account-confirm-cancel"
                    onclick="closeToggleAccountModal()">

                <i class="fa-solid fa-xmark"></i>

                Hủy

            </button>


            <button type="button"
                    id="accountConfirmSubmit"
                    class="account-confirm-submit danger"
                    onclick="submitToggleAccount()">

                <i class="fa-solid fa-lock"></i>

                <span>
                    Khóa tài khoản
                </span>

            </button>


        </div>

    </div>

</div>


@section Scripts {

    <script>

        // =====================================================
        // CUSTOM LOCK / UNLOCK MODAL
        // =====================================================

        let pendingToggleForm =
            null;


        function openToggleAccountModal(
            form,
            username,
            isActive
        ) {

            pendingToggleForm =
                form;


            const modal =
                document.getElementById(
                    "accountConfirmModal"
                );


            const title =
                document.getElementById(
                    "accountConfirmTitle"
                );


            const message =
                document.getElementById(
                    "accountConfirmMessage"
                );


            const usernameText =
                document.getElementById(
                    "accountConfirmUsername"
                );


            const icon =
                document.getElementById(
                    "accountConfirmIcon"
                );


            const submitButton =
                document.getElementById(
                    "accountConfirmSubmit"
                );


            usernameText.textContent =
                username;


            // =================================================
            // LOCK
            // =================================================

            if (isActive) {

                title.textContent =
                    "Khóa tài khoản?";


                message.textContent =
                    "Tài khoản này sẽ tạm thời không thể đăng nhập hoặc truy cập hệ thống.";


                icon.className =
                    "account-confirm-icon danger";


                icon.innerHTML =
                    '<i class="fa-solid fa-user-lock"></i>';


                submitButton.className =
                    "account-confirm-submit danger";


                submitButton.innerHTML =
                    '<i class="fa-solid fa-lock"></i>' +
                    '<span>Khóa tài khoản</span>';

            }


            // =================================================
            // UNLOCK
            // =================================================

            else {

                title.textContent =
                    "Mở khóa tài khoản?";


                message.textContent =
                    "Tài khoản sẽ được khôi phục quyền đăng nhập và sử dụng hệ thống.";


                icon.className =
                    "account-confirm-icon success";


                icon.innerHTML =
                    '<i class="fa-solid fa-lock-open"></i>';


                submitButton.className =
                    "account-confirm-submit success";


                submitButton.innerHTML =
                    '<i class="fa-solid fa-lock-open"></i>' +
                    '<span>Mở khóa tài khoản</span>';

            }


            modal.classList.add(
                "show"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.classList.add(
                "account-modal-open"
            );


            return false;
        }


        // =====================================================
        // CLOSE MODAL
        // =====================================================

        function closeToggleAccountModal() {

            const modal =
                document.getElementById(
                    "accountConfirmModal"
                );


            if (!modal) {
                return;
            }


            modal.classList.remove(
                "show"
            );


            modal.setAttribute(
                "aria-hidden",
                "true"
            );


            document.body.classList.remove(
                "account-modal-open"
            );


            pendingToggleForm =
                null;
        }


        // =====================================================
        // SUBMIT LOCK / UNLOCK
        // =====================================================

        function submitToggleAccount() {

            if (!pendingToggleForm) {
                return;
            }


            const form =
                pendingToggleForm;


            pendingToggleForm =
                null;


            form.submit();
        }


        // =====================================================
        // ESC CLOSE
        // =====================================================

        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    closeToggleAccountModal();

                }

            }
        );


        // =====================================================
        // SUCCESS TOAST
        // =====================================================

        function closeAdminToast() {

            const toast =
                document.getElementById(
                    "adminSuccessToast"
                );


            if (!toast) {
                return;
            }


            toast.classList.add(
                "hide"
            );


            setTimeout(
                function () {

                    toast.remove();

                },
                300
            );
        }


        // =====================================================
        // ERROR TOAST
        // =====================================================

        function closeAdminErrorToast() {

            const toast =
                document.getElementById(
                    "adminErrorToast"
                );


            if (!toast) {
                return;
            }


            toast.classList.add(
                "hide"
            );


            setTimeout(
                function () {

                    toast.remove();

                },
                300
            );
        }


        // =====================================================
        // AUTO CLOSE TOAST
        // =====================================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const successToast =
                    document.getElementById(
                        "adminSuccessToast"
                    );


                if (successToast) {

                    setTimeout(
                        closeAdminToast,
                        3000
                    );

                }


                const errorToast =
                    document.getElementById(
                        "adminErrorToast"
                    );


                if (errorToast) {

                    setTimeout(
                        closeAdminErrorToast,
                        4000
                    );

                }

            }
        );

    </script>

}