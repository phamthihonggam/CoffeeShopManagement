@using CoffeeShopManagement.Models

@model CoffeeShopManagement.Models.TaiKhoan

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";

    var roles =
        ViewBag.Roles as List<VaiTro>
        ?? new List<VaiTro>();

    int? selectedRole =
        ViewBag.SelectedRole as int?;
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/admin-account.css"
          asp-append-version="true" />

}


<div class="account-page">


    <div class="account-intro">

        <div class="account-intro-content">

            <span class="account-label">

                <i class="fa-solid fa-user-pen"></i>

                ROSALIE COFFEE

            </span>

            <h2>
                Chỉnh sửa tài khoản
            </h2>

            <p>
                Cập nhật thông tin cá nhân, ảnh đại diện
                và vai trò của tài khoản.
            </p>

        </div>


        <a asp-area="Admin"
           asp-controller="AccountManagement"
           asp-action="Index"
           class="account-reset-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Quay lại

        </a>

    </div>


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="account-alert account-alert-error">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @TempData["ErrorMessage"]
            </span>

        </div>
    }


    <div class="account-table-card">

        <div class="account-table-header account-form-header">

            <div>

                <span class="account-table-label">
                    CHỈNH SỬA
                </span>

                <h3>
                    @Model.TenDangNhap
                </h3>

                <p>
                    ID tài khoản: @Model.MaTaiKhoan
                </p>

            </div>

            <span class="account-status @(Model.IsActive ? "active" : "locked")">

                <span class="status-dot"></span>

                @(Model.IsActive ? "Hoạt động" : "Đã khóa")

            </span>

        </div>


        <form asp-area="Admin"
              asp-controller="AccountManagement"
              asp-action="Edit"
              asp-route-id="@Model.MaTaiKhoan"
              method="post"
              enctype="multipart/form-data"
              class="account-create-form">

            @Html.AntiForgeryToken()


            <!-- AVATAR -->

            <div class="account-form-group account-avatar-group">

                <label>
                    Ảnh đại diện
                </label>

                <div class="account-avatar-upload">

                    <div class="account-avatar-preview">

                        @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
                        {
                            <img id="avatarPreview"
                                 src="~/images/avatars/@Model.HinhAnh"
                                 asp-append-version="true"
                                 alt="@Model.HoTen"
                                 style="display:block;" />

                            <div id="avatarPlaceholder"
                                 class="account-avatar-placeholder"
                                 style="display:none;">

                                <i class="fa-solid fa-user"></i>

                            </div>
                        }
                        else
                        {
                            <img id="avatarPreview"
                                 alt="@Model.HoTen" />

                            <div id="avatarPlaceholder"
                                 class="account-avatar-placeholder">

                                <i class="fa-solid fa-user"></i>

                            </div>
                        }

                    </div>


                    <div class="account-avatar-input">

                        <label for="hinhAnh"
                               class="account-avatar-select">

                            <i class="fa-regular fa-image"></i>

                            Đổi ảnh

                        </label>

                        <input type="file"
                               id="hinhAnh"
                               name="hinhAnh"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                        <span>
                            Bỏ trống nếu muốn giữ ảnh hiện tại.
                        </span>

                    </div>

                </div>

            </div>


            <!-- USERNAME -->

            <div class="account-form-group">

                <label>
                    Tên đăng nhập
                </label>

                <div class="account-form-control-wrap account-readonly">

                    <i class="fa-solid fa-user"></i>

                    <input type="text"
                           value="@Model.TenDangNhap"
                           readonly />

                </div>

                <small class="account-field-note">
                    Tên đăng nhập không thể thay đổi.
                </small>

            </div>


            <!-- ROLE -->

            <div class="account-form-group">

                <label for="maVaiTro">
                    Vai trò
                    <span>*</span>
                </label>

                <div class="account-form-control-wrap">

                    <i class="fa-solid fa-shield-halved"></i>

                    <select id="maVaiTro"
                            name="maVaiTro"
                            required>

                        @foreach (var role in roles)
                        {
                            if (selectedRole.HasValue &&
                                selectedRole.Value == role.MaVaiTro)
                            {
                                <option value="@role.MaVaiTro"
                                        selected>
                                    @role.TenVaiTro
                                </option>
                            }
                            else
                            {
                                <option value="@role.MaVaiTro">
                                    @role.TenVaiTro
                                </option>
                            }
                        }

                    </select>

                </div>

            </div>


            <!-- FULL NAME -->

            <div class="account-form-group">

                <label for="hoTen">
                    Họ và tên
                    <span>*</span>
                </label>

                <div class="account-form-control-wrap">

                    <i class="fa-solid fa-id-card"></i>

                    <input type="text"
                           id="hoTen"
                           name="hoTen"
                           value="@Model.HoTen"
                           required />

                </div>

            </div>


            <!-- EMAIL -->

            <div class="account-form-group">

                <label for="email">
                    Email
                </label>

                <div class="account-form-control-wrap">

                    <i class="fa-regular fa-envelope"></i>

                    <input type="email"
                           id="email"
                           name="email"
                           value="@Model.Email"
                           placeholder="example@gmail.com" />

                </div>

            </div>


            <!-- PHONE -->

            <div class="account-form-group">

                <label for="dienThoai">
                    Số điện thoại
                </label>

                <div class="account-form-control-wrap">

                    <i class="fa-solid fa-phone"></i>

                    <input type="text"
                           id="dienThoai"
                           name="dienThoai"
                           value="@Model.DienThoai"
                           placeholder="Nhập số điện thoại" />

                </div>

            </div>


            <!-- SECURITY -->

            <div class="account-form-group">

                <label>
                    Bảo mật
                </label>

                <a asp-area="Admin"
                   asp-controller="AccountManagement"
                   asp-action="ResetPassword"
                   asp-route-id="@Model.MaTaiKhoan"
                   class="account-security-link">

                    <span>

                        <i class="fa-solid fa-key"></i>

                        Đặt lại mật khẩu

                    </span>

                    <i class="fa-solid fa-chevron-right"></i>

                </a>

            </div>


            <div class="account-form-actions">

                <a asp-area="Admin"
                   asp-controller="AccountManagement"
                   asp-action="Index"
                   class="account-cancel-btn">

                    Hủy

                </a>

                <button type="submit"
                        class="account-submit-btn">

                    <i class="fa-solid fa-floppy-disk"></i>

                    Lưu thay đổi

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const input =
                    document.getElementById("hinhAnh");

                const preview =
                    document.getElementById("avatarPreview");

                const placeholder =
                    document.getElementById("avatarPlaceholder");

                if (!input ||
                    !preview ||
                    !placeholder) {
                    return;
                }

                input.addEventListener(
                    "change",
                    function() {

                        const file =
                            this.files?.[0];

                        if (!file) {
                            return;
                        }

                        if (file.size >
                            5 * 1024 * 1024) {

                            alert(
                                "Ảnh đại diện không được vượt quá 5MB."
                            );

                            input.value = "";

                            return;
                        }

                        const reader =
                            new FileReader();

                        reader.onload =
                            function(event) {

                                preview.src =
                                    event.target.result;

                                preview.style.display =
                                    "block";

                                placeholder.style.display =
                                    "none";

                            };

                        reader.readAsDataURL(
                            file
                        );

                    }
                );

            }
        );

    </script>

}