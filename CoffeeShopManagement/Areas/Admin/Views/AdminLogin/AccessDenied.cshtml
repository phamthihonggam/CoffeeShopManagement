@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<section class="admin-access-denied-page">

    <div class="admin-access-denied-card">

        <div class="admin-access-denied-icon">
            <i class="fa-solid fa-shield-halved"></i>
        </div>

        <h1>
            Không có quyền truy cập
        </h1>

        <p>
            Tài khoản của bạn không được cấp quyền
            truy cập chức năng này.
        </p>

        <div class="admin-access-denied-actions">

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="admin-access-denied-back">

                <i class="fa-solid fa-arrow-left"></i>

                Về trang tổng quan

            </a>

        </div>

    </div>

</section>

<style>

    .admin-access-denied-page {
        min-height: calc(100vh - 170px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .admin-access-denied-card {
        width: 100%;
        max-width: 520px;
        padding: 50px 40px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #eadfd8;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(75, 46, 43, 0.08);
    }

    .admin-access-denied-icon {
        width: 74px;
        height: 74px;
        margin: 0 auto 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff0ee;
        color: #c64d45;
        font-size: 29px;
    }

    .admin-access-denied-card h1 {
        margin: 0 0 12px;
        color: #4b2e2b;
        font-size: 28px;
        font-weight: 800;
    }

    .admin-access-denied-card p {
        max-width: 400px;
        margin: 0 auto 28px;
        color: #7c6b63;
        font-size: 14px;
        line-height: 1.7;
    }

    .admin-access-denied-actions {
        display: flex;
        justify-content: center;
    }

    .admin-access-denied-back {
        min-height: 44px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border-radius: 11px;
        background: #754833;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .admin-access-denied-back:hover {
        background: #5d3829;
        color: #ffffff;
        text-decoration: none;
    }

</style>