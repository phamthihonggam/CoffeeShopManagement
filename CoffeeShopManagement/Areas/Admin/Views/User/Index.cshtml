@model IEnumerable<CoffeeShopManagement.Models.KhachHang>

@{
    ViewData["Title"] = "Quản lý người dùng";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
    int startItem = ViewBag.StartItem ?? 0;
    int endItem = ViewBag.EndItem ?? 0;

    string? keyword =
        ViewBag.Keyword?.ToString();
}


@section Styles {

    <link rel="stylesheet"
          href="~/css/admin-user.css"
          asp-append-version="true" />

}


<!-- =====================================================
     HEADER
===================================================== -->

<div class="admin-welcome">

    <div class="user-admin-heading">

        <div>

            <h2>
                Quản lý người dùng
            </h2>

            <p>
                Theo dõi thông tin khách hàng
                đã đăng ký tại Rosalie Coffee.
            </p>

        </div>

    </div>

</div>


<!-- =====================================================
     QUICK STATS
===================================================== -->

<div class="admin-user-stats">

    <!-- TỔNG KHÁCH HÀNG -->

    <div class="admin-user-stat-card">

        <div class="admin-user-stat-icon">

            <i class="fa-solid fa-users"></i>

        </div>

        <span>
            Tổng khách hàng
        </span>

        <strong>
            @ViewBag.TotalCustomers
        </strong>

    </div>


    <!-- ĐÃ MUA HÀNG -->

    <div class="admin-user-stat-card">

        <div class="admin-user-stat-icon">

            <i class="fa-solid fa-bag-shopping"></i>

        </div>

        <span>
            Đã mua hàng
        </span>

        <strong>
            @ViewBag.CustomersWithOrders
        </strong>

    </div>


    <!-- KHÁCH MỚI -->

    <div class="admin-user-stat-card">

        <div class="admin-user-stat-icon">

            <i class="fa-solid fa-user-plus"></i>

        </div>

        <span>
            Khách mới 30 ngày
        </span>

        <strong>
            @ViewBag.NewCustomers
        </strong>

    </div>

</div>


<!-- =====================================================
     SEARCH
===================================================== -->

<div class="admin-user-toolbar">

    <form method="get"
          asp-area="Admin"
          asp-controller="User"
          asp-action="Index"
          class="admin-user-search-form">

        <!-- SEARCH BOX -->

        <div class="admin-user-search">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   name="keyword"
                   value="@keyword"
                   placeholder="Tìm họ tên, email hoặc số điện thoại..."
                   autocomplete="off" />

        </div>


        <!-- GIỮ SỐ DÒNG / TRANG -->

        <input type="hidden"
               name="pageSize"
               value="@pageSize" />


        <!-- SEARCH BUTTON -->

        <button type="submit"
                class="admin-user-search-btn">

            <i class="fa-solid fa-magnifying-glass"></i>

            Tìm kiếm

        </button>


        <!-- RESET -->
        @if (!string.IsNullOrWhiteSpace(keyword))
        {
            <a asp-area="Admin"
               asp-controller="User"
               asp-action="Index"
               class="admin-user-reset-btn">

                <i class="fa-solid fa-rotate-left"></i>

                Đặt lại

            </a>
        }

    </form>

</div>


<!-- =====================================================
     TABLE
===================================================== -->

<div class="admin-user-card">

    <div class="admin-user-table-wrap">

        <table class="admin-user-table">

            <thead>

                <tr>

                    <th>
                        Mã
                    </th>

                    <th>
                        Khách hàng
                    </th>

                    <th>
                        Liên hệ
                    </th>

                    <th>
                        Ngày đăng ký
                    </th>

                    <th>
                        Số đơn
                    </th>

                    <th>
                        Thao tác
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- =================================================
                                 MÃ KHÁCH HÀNG
                            ================================================== -->

                            <td>

                                <span class="admin-user-id">

                                    #@item.MaKh

                                </span>

                            </td>


                            <!-- =================================================
                                 THÔNG TIN KHÁCH HÀNG
                            ================================================== -->

                            <td>

                                <div class="admin-user-info">

                                    <div class="admin-user-avatar">

                                        <i class="fa-solid fa-user"></i>

                                    </div>


                                    <div>

                                        <strong>

                                            @item.HoTen

                                        </strong>


                                        @if (!string.IsNullOrWhiteSpace(
                                            item.DiaChi))
                                        {
                                            <span>

                                                <i class="fa-solid fa-location-dot"></i>

                                                @item.DiaChi

                                            </span>
                                        }

                                    </div>

                                </div>

                            </td>


                            <!-- =================================================
                                 LIÊN HỆ
                            ================================================== -->

                            <td>

                                <div class="admin-user-contact">

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.Email))
                                    {
                                        <span>

                                            <i class="fa-regular fa-envelope"></i>

                                            @item.Email

                                        </span>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(
                                        item.DienThoai))
                                    {
                                        <span>

                                            <i class="fa-solid fa-phone"></i>

                                            @item.DienThoai

                                        </span>
                                    }

                                </div>

                            </td>


                            <!-- =================================================
                                 NGÀY ĐĂNG KÝ
                            ================================================== -->

                            <td>

                                <div class="admin-user-date">

                                    <strong>

                                        @item.NgayTao.ToString("dd/MM/yyyy")

                                    </strong>

                                    <span>

                                        @item.NgayTao.ToString("HH:mm")

                                    </span>

                                </div>

                            </td>


                            <!-- =================================================
                                 SỐ ĐƠN
                            ================================================== -->

                            <td>

                                <span class="admin-user-order-count">

                                    @item.HoaDons.Count
                                    đơn

                                </span>

                            </td>


                            <!-- =================================================
                                 THAO TÁC
                            ================================================== -->

                            <td>

                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Details"
                                   asp-route-id="@item.MaKh"
                                   class="admin-user-view-btn"
                                   title="Xem chi tiết khách hàng">

                                    <i class="fa-solid fa-eye"></i>

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6">

                            <div class="admin-user-empty">

                                <i class="fa-solid fa-users"></i>

                                <h3>

                                    Không tìm thấy khách hàng

                                </h3>

                                <p>

                                    Thử nhập từ khóa khác
                                    hoặc đặt lại tìm kiếm.

                                </p>


                                @if (!string.IsNullOrWhiteSpace(keyword))
                                {
                                    <a asp-area="Admin"
                                       asp-controller="User"
                                       asp-action="Index"
                                       class="admin-user-reset-btn">

                                        <i class="fa-solid fa-rotate-left"></i>

                                        Đặt lại tìm kiếm

                                    </a>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- =====================================================
     PAGINATION
===================================================== -->
@if (totalItems > 0)
{
    <div class="admin-user-pagination-wrap">

        <!-- =================================================
             THÔNG TIN PHÂN TRANG
        ================================================== -->

        <div class="admin-user-pagination-info">

            Hiển thị

            <strong>
                @startItem
            </strong>

            –

            <strong>
                @endItem
            </strong>

            trong

            <strong>
                @totalItems
            </strong>

            khách hàng

        </div>


        <!-- =================================================
             PAGE SIZE
        ================================================== -->

        <form method="get"
              asp-area="Admin"
              asp-controller="User"
              asp-action="Index"
              class="admin-user-page-size">

            <input type="hidden"
                   name="keyword"
                   value="@keyword" />


            <span>

                Hiển thị

            </span>


            <select name="pageSize"
                    onchange="this.form.submit()">

                @foreach (var size in new[] { 10, 20, 50 })
                {
                    if (pageSize == size)
                    {
                        <option value="@size"
                                selected>

                            @size

                        </option>
                    }
                    else
                    {
                        <option value="@size">

                            @size

                        </option>
                    }
                }

            </select>


            <span>

                dòng / trang

            </span>

        </form>


        <!-- =================================================
             PAGE LINKS
        ================================================== -->
        @if (totalPages > 1)
        {
            <div class="admin-user-pagination">

                <!-- PREVIOUS -->

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   asp-route-keyword="@keyword"
                   asp-route-pageSize="@pageSize"
                   asp-route-page="@(currentPage - 1)"
                   class="admin-user-page-link @(currentPage <= 1 ? "disabled" : "")">

                    <i class="fa-solid fa-chevron-left"></i>

                    Trước

                </a>


                @{
                    int startPage =
                        Math.Max(
                            1,
                            currentPage - 2
                        );

                    int endPage =
                        Math.Min(
                            totalPages,
                            currentPage + 2
                        );
                }


                <!-- PAGE 1 + ... -->
                @if (startPage > 1)
                {
                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-keyword="@keyword"
                       asp-route-pageSize="@pageSize"
                       asp-route-page="1"
                       class="admin-user-page-link">

                        1

                    </a>


                    @if (startPage > 2)
                    {
                        <span class="admin-user-page-dots">

                            ...

                        </span>
                    }
                }


                <!-- CURRENT RANGE -->
                @for (int i = startPage;
                                      i <= endPage;
                                      i++)
                {
                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-keyword="@keyword"
                       asp-route-pageSize="@pageSize"
                       asp-route-page="@i"
                       class="admin-user-page-link @(i == currentPage ? "active" : "")">

                        @i

                    </a>
                }


                <!-- ... + LAST PAGE -->
                @if (endPage < totalPages)
                {
                    @if (endPage <
                         totalPages - 1)
                    {
                        <span class="admin-user-page-dots">

                            ...

                        </span>
                    }


                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-keyword="@keyword"
                       asp-route-pageSize="@pageSize"
                       asp-route-page="@totalPages"
                       class="admin-user-page-link">

                        @totalPages

                    </a>
                }


                <!-- NEXT -->

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   asp-route-keyword="@keyword"
                   asp-route-pageSize="@pageSize"
                   asp-route-page="@(currentPage + 1)"
                   class="admin-user-page-link @(currentPage >= totalPages ? "disabled" : "")">

                    Sau

                    <i class="fa-solid fa-chevron-right"></i>

                </a>

            </div>
        }

    </div>
}