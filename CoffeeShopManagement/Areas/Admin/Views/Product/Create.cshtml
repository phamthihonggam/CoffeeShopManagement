@model CoffeeShopManagement.Models.SanPham

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/admin-product.css"
          asp-append-version="true" />

}


<!-- =========================================
     HEADER
========================================= -->

<div class="admin-welcome">

    <div class="product-admin-heading">

        <div>

            <h2>
                Thêm sản phẩm mới
            </h2>

            <p>
                Thêm đồ uống hoặc sản phẩm mới
                vào hệ thống Rosalie Coffee.
            </p>

        </div>


        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="admin-reset-search">

            <i class="fa-solid fa-arrow-left"></i>

            Quay lại

        </a>

    </div>

</div>


<!-- =========================================
     CREATE FORM
========================================= -->

<form asp-area="Admin"
      asp-controller="Product"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      class="admin-product-form">

    @Html.AntiForgeryToken()


    <!-- VALIDATION -->

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>


    <div class="admin-form-grid">


        <!-- =====================================
             TÊN SẢN PHẨM
        ====================================== -->

        <div class="admin-form-group admin-form-full">

            <label asp-for="TenSp">
                Tên sản phẩm
            </label>

            <input asp-for="TenSp"
                   class="admin-form-control"
                   placeholder="Ví dụ: Cafe Latte" />

            <span asp-validation-for="TenSp"
                  class="text-danger">
            </span>

        </div>


        <!-- =====================================
             DANH MỤC
        ====================================== -->

        <div class="admin-form-group">

            <label asp-for="MaLoai">
                Danh mục
            </label>

            <select asp-for="MaLoai"
                    asp-items="ViewBag.Categories"
                    class="admin-form-control">

                <option value="">
                    -- Chọn danh mục --
                </option>

            </select>

            <span asp-validation-for="MaLoai"
                  class="text-danger">
            </span>

        </div>


        <!-- =====================================
             GIÁ BÁN
        ====================================== -->

        <div class="admin-form-group">

            <label asp-for="DonGia">
                Giá bán
            </label>

            <div class="admin-form-price">

                <input asp-for="DonGia"
                       type="number"
                       min="0"
                       step="1000"
                       class="admin-form-control"
                       placeholder="45000" />

                <span>
                    đ
                </span>

            </div>

            <span asp-validation-for="DonGia"
                  class="text-danger">
            </span>

        </div>


        <!-- =====================================
             MÔ TẢ
        ====================================== -->

        <div class="admin-form-group admin-form-full">

            <label asp-for="MoTa">
                Mô tả sản phẩm
            </label>

            <textarea asp-for="MoTa"
                      class="admin-form-control admin-form-textarea"
                      rows="5"
                      placeholder="Nhập mô tả sản phẩm..."></textarea>

            <span asp-validation-for="MoTa"
                  class="text-danger">
            </span>

        </div>


        <!-- =====================================
             HÌNH ẢNH
        ====================================== -->

        <div class="admin-form-group admin-form-full">

            <label>
                Hình ảnh sản phẩm
            </label>


            <div class="admin-upload-box">

                <input type="file"
                       name="imageFile"
                       id="imageFile"
                       accept="image/jpeg,image/png,image/webp"
                       class="admin-file-input" />


                <div class="admin-upload-content">

                    <i class="fa-solid fa-cloud-arrow-up"></i>

                    <strong>
                        Chọn ảnh sản phẩm
                    </strong>

                    <span>
                        JPG, JPEG, PNG hoặc WEBP
                    </span>

                </div>

            </div>


            <!-- IMAGE PREVIEW -->

            <div class="admin-image-preview"
                 id="imagePreview">

                <img id="previewImage"
                     src=""
                     alt="Xem trước hình ảnh sản phẩm" />

            </div>

        </div>


        <!-- =====================================
             KHUYẾN MÃI
        ====================================== -->

        <div class="admin-form-group admin-form-full">

            <div class="admin-promotion-switch">

                <label class="admin-switch-label">

                    <input asp-for="DangKhuyenMai"
                           id="promotionToggle"
                           type="checkbox" />

                    <span class="admin-switch">
                    </span>

                    <strong>
                        Áp dụng khuyến mãi
                    </strong>

                </label>

            </div>

        </div>


        <!-- =====================================
             THÔNG TIN KHUYẾN MÃI
        ====================================== -->

        <div id="promotionFields"
             class="admin-promotion-fields admin-form-full">


            <!-- GIÁ GỐC -->

            <div class="admin-form-group">

                <label asp-for="GiaGoc">
                    Giá gốc
                </label>

                <div class="admin-form-price">

                    <input asp-for="GiaGoc"
                           type="number"
                           min="0"
                           step="1000"
                           class="admin-form-control"
                           placeholder="50000" />

                    <span>
                        đ
                    </span>

                </div>

                <span asp-validation-for="GiaGoc"
                      class="text-danger">
                </span>

            </div>


            <!-- GIÁ KHUYẾN MÃI -->

            <div class="admin-form-group">

                <label asp-for="GiaKhuyenMai">
                    Giá khuyến mãi
                </label>

                <div class="admin-form-price">

                    <input asp-for="GiaKhuyenMai"
                           type="number"
                           min="0"
                           step="1000"
                           class="admin-form-control"
                           placeholder="40000" />

                    <span>
                        đ
                    </span>

                </div>

                <span asp-validation-for="GiaKhuyenMai"
                      class="text-danger">
                </span>

            </div>


            <!-- PHẦN TRĂM GIẢM -->

            <div class="admin-form-group">

                <label asp-for="PhanTramGiam">
                    Phần trăm giảm
                </label>

                <div class="admin-form-price">

                    <input asp-for="PhanTramGiam"
                           type="number"
                           min="0"
                           max="100"
                           class="admin-form-control"
                           placeholder="20" />

                    <span>
                        %
                    </span>

                </div>

                <span asp-validation-for="PhanTramGiam"
                      class="text-danger">
                </span>

            </div>


            <!-- NGÀY BẮT ĐẦU -->

            <div class="admin-form-group">

                <label asp-for="NgayBatDau">
                    Ngày bắt đầu
                </label>

                <input asp-for="NgayBatDau"
                       type="datetime-local"
                       class="admin-form-control" />

                <span asp-validation-for="NgayBatDau"
                      class="text-danger">
                </span>

            </div>


            <!-- NGÀY KẾT THÚC -->

            <div class="admin-form-group">

                <label asp-for="NgayKetThuc">
                    Ngày kết thúc
                </label>

                <input asp-for="NgayKetThuc"
                       type="datetime-local"
                       class="admin-form-control" />

                <span asp-validation-for="NgayKetThuc"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>


    <!-- =========================================
         ACTIONS
    ========================================== -->

    <div class="admin-form-actions">

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="admin-form-cancel">

            <i class="fa-solid fa-xmark"></i>

            Hủy

        </a>


        <button type="submit"
                class="admin-form-submit">

            <i class="fa-solid fa-floppy-disk"></i>

            Lưu sản phẩm

        </button>

    </div>

</form>


<!-- =========================================
     SCRIPTS
========================================= -->
@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/admin-product.js"
            asp-append-version="true">
    </script>

}