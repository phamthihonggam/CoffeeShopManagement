@{
    var title =
        ViewData["Title"]?.ToString()
        ?? "Nhân viên";


    // =====================================================
    // STAFF SESSION
    // DÙNG CHUNG SESSION ĐĂNG NHẬP ADMIN / STAFF
    // =====================================================

    var staffFullName =
        Context.Session.GetString("AdminFullName")
        ?? Context.Session.GetString("HoTen")
        ?? User.Identity?.Name
        ?? "Nhân viên Rosalie";


    var staffRole =
        Context.Session.GetString("AdminRole")
        ?? Context.Session.GetString("VaiTro")
        ?? "Nhân viên";


    var staffUsername =
        Context.Session.GetString("AdminUsername")
        ?? Context.Session.GetString("TenDangNhap")
        ?? User.Identity?.Name
        ?? "nhanvien";


    var staffAvatar =
        Context.Session.GetString("AdminAvatar");


    var permissionString =
        Context.Session.GetString("AdminPermissions")
        ?? "";


    // =====================================================
    // PERMISSIONS
    // =====================================================

    var permissions =
        permissionString.Split(
            '|',
            StringSplitOptions.RemoveEmptyEntries
        );


    bool HasPermission(
        string permission)
    {
        return permissions.Any(
            x => string.Equals(
                x,
                permission,
                StringComparison.OrdinalIgnoreCase
            )
        );
    }


    // =====================================================
    // STAFF CHECK
    // =====================================================

    var isStaff =
        staffRole.Equals(
            "Nhân viên",
            StringComparison.OrdinalIgnoreCase
        )
        ||
        staffRole.Equals(
            "NhanVien",
            StringComparison.OrdinalIgnoreCase
        )
        ||
        staffRole.Equals(
            "Nhan Vien",
            StringComparison.OrdinalIgnoreCase
        )
        ||
        staffRole.Equals(
            "Staff",
            StringComparison.OrdinalIgnoreCase
        );


    // =====================================================
    // AVATAR FALLBACK
    // =====================================================

    var avatarLetter =
        !string.IsNullOrWhiteSpace(staffFullName)
            ? staffFullName.Substring(0, 1).ToUpper()
            : "N";
}


<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>
        @title - Rosalie Coffee
    </title>


    <!-- =====================================================
         BOOTSTRAP
    ====================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         FONT AWESOME
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- =====================================================
         ADMIN SHARED CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />


    <!-- =====================================================
         STAFF CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/staff.css"
          asp-append-version="true" />


    <!-- =====================================================
         PAGE CSS
    ====================================================== -->
    @RenderSection(
            "Styles",
            required: false
        )

</head>


<body>


    <div class="admin-wrapper">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="admin-sidebar">


            <!-- =================================================
                 LOGO
            ================================================== -->

            <a asp-area="Staff"
               asp-controller="Dashboard"
               asp-action="Index"
               class="admin-logo"
               style="text-decoration:none;">

                <img src="~/images/logo/logo.png"
                     alt="Rosalie Coffee" />


                <div>

                    <h2>
                        ROSALIE
                    </h2>

                    <span>
                        NHÂN VIÊN
                    </span>

                </div>

            </a>


            <!-- =================================================
                 MENU
            ================================================== -->

            <nav class="admin-menu">


                <!-- =============================================
                     DASHBOARD
                ============================================== -->
                @if (HasPermission("DASHBOARD_VIEW"))
                {
                    <a asp-area="Staff"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="admin-menu-item">

                        <i class="fa-solid fa-chart-pie"></i>

                        <span>
                            Tổng quan
                        </span>

                    </a>
                }


                <!-- =============================================
                     ORDER
                ============================================== -->
                @if (HasPermission("ORDER_MANAGE"))
                {
                    <a asp-area="Staff"
                       asp-controller="Order"
                       asp-action="Index"
                       class="admin-menu-item">

                        <i class="fa-solid fa-receipt"></i>

                        <span>
                            Đơn hàng
                        </span>

                    </a>
                }


                <!-- =============================================
                     PRODUCT
                ============================================== -->
                @if (HasPermission("PRODUCT_MANAGE"))
                {
                    <a asp-area="Staff"
                       asp-controller="Product"
                       asp-action="Index"
                       class="admin-menu-item">

                        <i class="fa-solid fa-mug-hot"></i>

                        <span>
                            Sản phẩm
                        </span>

                    </a>
                }


                <!-- =============================================
                     CUSTOMER
                ============================================== -->
                @if (HasPermission("CUSTOMER_VIEW"))
                {
                    <a asp-area="Staff"
                       asp-controller="Customer"
                       asp-action="Index"
                       class="admin-menu-item">

                        <i class="fa-solid fa-users"></i>

                        <span>
                            Khách hàng
                        </span>

                    </a>
                }


                <!-- =============================================
                     REVIEW
                     STAFF ĐƯỢC XỬ LÝ ĐÁNH GIÁ
                ============================================== -->
                @if (isStaff)
                {
                    <a asp-area="Staff"
                       asp-controller="Review"
                       asp-action="Index"
                       class="admin-menu-item">

                        <i class="fa-solid fa-star"></i>

                        <span>
                            Đánh giá
                        </span>

                    </a>
                }


            </nav>


            <!--
                KHÔNG CÒN:

                Website
                Đăng xuất

                Ở cuối sidebar.

                Xem website nằm ở Header.
                Đăng xuất nằm trong Account Dropdown.
            -->


        </aside>


        <!-- =====================================================
             MAIN
        ====================================================== -->

        <main class="admin-main">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <header class="admin-header">


                <!-- =============================================
                     LEFT
                ============================================== -->

                <div class="admin-header-left">

                    <span class="admin-header-label">
                        ROSALIE COFFEE
                    </span>

                    <h1>
                        @title
                    </h1>

                </div>


                <!-- =============================================
                     RIGHT
                ============================================== -->

                <div class="admin-header-right">


                    <!-- =========================================
                         VIEW WEBSITE
                    ========================================== -->

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="admin-view-site">

                        <i class="fa-solid fa-arrow-up-right-from-square"></i>

                        <span>
                            Xem website
                        </span>

                    </a>


                    <!-- =========================================
                         ACCOUNT DROPDOWN
                    ========================================== -->

                    <div class="admin-account-dropdown">


                        <!-- =====================================
                             ACCOUNT BUTTON
                        ====================================== -->

                        <button type="button"
                                class="admin-account admin-account-button"
                                id="staffAccountButton"
                                aria-haspopup="true"
                                aria-controls="staffAccountMenu"
                                aria-expanded="false">


                            <!-- AVATAR -->

                            <div class="admin-avatar">

                                @if (!string.IsNullOrWhiteSpace(staffAvatar))
                                {
                                    <img src="~/images/avatars/@staffAvatar"
                                         alt="@staffFullName"
                                         class="admin-avatar-image"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <span class="admin-avatar-fallback"
                                          style="display:none;">

                                        @avatarLetter

                                    </span>
                                }
                                else
                                {
                                    <span class="admin-avatar-fallback">

                                        <i class="fa-solid fa-user-tie"></i>

                                    </span>
                                }

                            </div>


                            <!-- INFO -->

                            <div class="admin-account-info">

                                <strong>
                                    @staffFullName
                                </strong>

                                <span>
                                    Nhân viên
                                </span>

                            </div>


                            <!-- ARROW -->

                            <i class="fa-solid fa-chevron-down admin-account-arrow"></i>

                        </button>


                        <!-- =====================================
                             ACCOUNT MENU
                        ====================================== -->

                        <div class="admin-account-menu"
                             id="staffAccountMenu">


                            <!-- =================================
                                 USER HEADER
                            ================================== -->

                            <div class="admin-account-menu-header">


                                <!-- AVATAR -->

                                <div class="admin-dropdown-avatar">

                                    @if (!string.IsNullOrWhiteSpace(staffAvatar))
                                    {
                                        <img src="~/images/avatars/@staffAvatar"
                                             alt="@staffFullName"
                                             class="admin-dropdown-avatar-image"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                        <span style="display:none;">
                                            @avatarLetter
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            @avatarLetter
                                        </span>
                                    }

                                </div>


                                <!-- USER INFO -->

                                <div>

                                    <strong>
                                        @staffFullName
                                    </strong>

                                    <span>
                                        @($"@{staffUsername}")
                                    </span>

                                </div>

                            </div>


                            <!-- =================================
                                 ROLE
                            ================================== -->

                            <div class="admin-account-role">

                                <span>
                                    Vai trò
                                </span>

                                <strong>
                                    Nhân viên
                                </strong>

                            </div>


                            <!-- =================================
                                 DIVIDER
                            ================================== -->

                            <div class="admin-account-divider"></div>


                            <!-- =================================
                                 LOGOUT
                            ================================== -->

                            <form asp-area="Admin"
                                  asp-controller="AdminLogin"
                                  asp-action="Logout"
                                  method="post"
                                  class="admin-dropdown-logout-form">

                                @Html.AntiForgeryToken()


                                <button type="submit"
                                        class="admin-account-menu-item admin-dropdown-logout">

                                    <i class="fa-solid fa-arrow-right-from-bracket"></i>

                                    <span>
                                        Đăng xuất
                                    </span>

                                </button>

                            </form>


                        </div>

                    </div>


                </div>

            </header>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <section class="admin-content">

                @RenderBody()

            </section>


        </main>


    </div>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =====================================================
         STAFF ACCOUNT DROPDOWN
    ====================================================== -->

    <script>

            document.addEventListener(
                "DOMContentLoaded",
                function() {

                    const button =
                        document.getElementById(
                            "staffAccountButton"
                        );


                    const menu =
                        document.getElementById(
                            "staffAccountMenu"
                        );


                    if (!button || !menu) {

                        return;

                    }


                    // =================================================
                    // OPEN / CLOSE
                    // =================================================

                    button.addEventListener(
                        "click",
                        function(event) {

                            event.stopPropagation();


                            const isOpen =
                                menu.classList.toggle(
                                    "show"
                                );


                            button.classList.toggle(
                                "active",
                                isOpen
                            );


                            button.setAttribute(
                                "aria-expanded",
                                isOpen
                                    ? "true"
                                    : "false"
                            );

                        }
                    );


                    // =================================================
                    // CLICK INSIDE MENU
                    // =================================================

                    menu.addEventListener(
                        "click",
                        function(event) {

                            event.stopPropagation();

                        }
                    );


                    // =================================================
                    // CLICK OUTSIDE
                    // =================================================

                    document.addEventListener(
                        "click",
                        function(event) {

                            if (
                                !menu.contains(event.target)
                                &&
                                !button.contains(event.target)
                            ) {
                                menu.classList.remove(
                                    "show"
                                );


                                button.classList.remove(
                                    "active"
                                );


                                button.setAttribute(
                                    "aria-expanded",
                                    "false"
                                );
                            }

                        }
                    );


                    // =================================================
                    // ESC CLOSE
                    // =================================================

                    document.addEventListener(
                        "keydown",
                        function(event) {

                            if (event.key !== "Escape") {

                                return;

                            }


                            menu.classList.remove(
                                "show"
                            );


                            button.classList.remove(
                                "active"
                            );


                            button.setAttribute(
                                "aria-expanded",
                                "false"
                            );

                        }
                    );

                }
            );

    </script>


    <!-- =====================================================
         PAGE JS
    ====================================================== -->
    @await RenderSectionAsync(
            "Scripts",
            required: false
        )


</body>

</html>