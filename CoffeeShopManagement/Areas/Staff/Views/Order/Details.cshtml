            </strong>

        </div>


        <div>

            <span>
                Phí giao hàng
            </span>

            <strong>
                @((Model.PhiGiaoHang ?? 0).ToString("#,##0"))đ
            </strong>

        </div>


        <div class="admin-order-payment-total">

            <span>
                Tổng thanh toán
            </span>

            <strong>
                @((Model.TongTien ?? 0).ToString("#,##0"))đ
            </strong>

        </div>


    </div>

</div>


<!-- =====================================================
     UPDATE ORDER STATUS
===================================================== -->
@if (
    !isCancelRequest
    &&
    currentStatus != "Hoàn thành"
    &&
    currentStatus != "Đã hủy"
    &&
    currentStatus != "Đã hủy - Chờ hoàn tiền"
    &&
    currentStatus != "Đã hủy - Đã hoàn tiền"
    &&
    currentStatus != "Đang giao hàng"
    &&
    currentStatus != "Chờ giao hàng"
    &&
    currentStatus != "Giao thất bại"
)
{
    <div class="admin-order-detail-card admin-order-items-card">

        <div class="admin-order-detail-title">

            <div class="admin-order-detail-icon">

                <i class="fa-solid fa-list-check"></i>

            </div>


            <div>

                <span>
                    XỬ LÝ ĐƠN
                </span>

                <h3>
                    Cập nhật tiến trình
                </h3>

            </div>

        </div>


        <div class="admin-order-actions">


            <!-- =================================================
                 CONFIRM
            ================================================== -->
            @if (
                            currentStatus == "Chờ xác nhận"
                            ||
                            currentStatus == "Chờ xử lý"
                            ||
                            currentStatus == "Đã thanh toán"
                        )
            {
                <form asp-area="Staff"
                      asp-controller="Order"
                      asp-action="UpdateStatus"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="id"
                           value="@Model.MaHd" />


                    <input type="hidden"
                           name="trangThai"
                           value="Đã xác nhận" />


                    <button type="submit"
                            class="admin-order-action-btn primary">

                        <i class="fa-solid fa-circle-check"></i>

                        Xác nhận đơn

                    </button>

                </form>
            }


            <!-- =================================================
                 PROCESSING
            ================================================== -->
            @if (currentStatus == "Đã xác nhận")
            {
                <form asp-area="Staff"
                      asp-controller="Order"
                      asp-action="UpdateStatus"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="id"
                           value="@Model.MaHd" />


                    <input type="hidden"
                           name="trangThai"
                           value="Đang xử lý" />


                    <button type="submit"
                            class="admin-order-action-btn primary">

                        <i class="fa-solid fa-gears"></i>

                        Bắt đầu xử lý

                    </button>

                </form>
            }


            <!-- =================================================
                 PREPARING
            ================================================== -->
            @if (currentStatus == "Đang xử lý")
            {
                <form asp-area="Staff"
                      asp-controller="Order"
                      asp-action="UpdateStatus"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="id"
                           value="@Model.MaHd" />


                    <input type="hidden"
                           name="trangThai"
                           value="Đang chuẩn bị" />


                    <button type="submit"
                            class="admin-order-action-btn primary">

                        <i class="fa-solid fa-mug-hot"></i>

                        Bắt đầu chuẩn bị

                    </button>

                </form>
            }


            <!-- =================================================
                 WAITING DELIVERY
            ================================================== -->
            @if (currentStatus == "Đang chuẩn bị")
            {
                <form asp-area="Staff"
                      asp-controller="Order"
                      asp-action="UpdateStatus"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="id"
                           value="@Model.MaHd" />


                    <input type="hidden"
                           name="trangThai"
                           value="Chờ giao hàng" />


                    <button type="submit"
                            class="admin-order-action-btn success">

                        <i class="fa-solid fa-box"></i>

                        Chuẩn bị xong - Chờ giao hàng

                    </button>

                </form>
            }


        </div>

    </div>
}


<!-- =====================================================
     INVOICE TEMPLATE
===================================================== -->

<div id="orderInvoicePrint"
     class="admin-invoice-document"
     data-order-code="HD@(Model.MaHd.ToString("D5"))">


    <!-- =================================================
         INVOICE HEADER
    ================================================== -->

    <div class="admin-invoice-header">

        <div>

            <div class="admin-invoice-brand">
                ROSALIE COFFEE
            </div>

            <div class="admin-invoice-subtitle">
                HÓA ĐƠN BÁN HÀNG
            </div>

        </div>


        <div class="admin-invoice-code">

            <span>
                MÃ HÓA ĐƠN
            </span>

            <strong>
                @($"#HD{Model.MaHd:D5}")
            </strong>

        </div>

    </div>


    <!-- =================================================
         INVOICE META
    ================================================== -->

    <div class="admin-invoice-meta">


        <div>

            <span>
                Ngày đặt
            </span>

            <strong>

                @(Model.NgayDat.HasValue
                    ? Model.NgayDat.Value.ToString("dd/MM/yyyy HH:mm")
                    : "Không xác định")

            </strong>

        </div>


        <div>

            <span>
                Thanh toán
            </span>

            <strong>
                @(isVnPay ? "VNPAY" : "COD")
            </strong>

        </div>


        <div>

            <span>
                Trạng thái
            </span>

            <strong>
                @(Model.TrangThai ?? "Chưa xác định")
            </strong>

        </div>


    </div>


    <!-- =================================================
         CUSTOMER
    ================================================== -->

    <div class="admin-invoice-section">

        <h3>
            Thông tin khách hàng
        </h3>


        <div class="admin-invoice-customer-grid">


            <div>

                <span>
                    Người nhận
                </span>

                <strong>
                    @receiverName
                </strong>

            </div>


            <div>

                <span>
                    Số điện thoại
                </span>

                <strong>
                    @receiverPhone
                </strong>

            </div>


            <div>

                <span>
                    Khu vực
                </span>

                <strong>
                    @(Model.QuanHuyenGiaoHang ?? "Chưa cập nhật")
                </strong>

            </div>


            <div class="admin-invoice-full">

                <span>
                    Địa chỉ giao hàng
                </span>

                <strong>
                    @receiverAddress
                </strong>

            </div>


        </div>

    </div>


    <!-- =================================================
         PRODUCTS
    ================================================== -->

    <div class="admin-invoice-section">

        <h3>
            Chi tiết đơn hàng
        </h3>


        <table class="admin-invoice-table">

            <thead>

                <tr>

                    <th>
                        #
                    </th>

                    <th>
                        Sản phẩm
                    </th>

                    <th>
                        Đơn giá
                    </th>

                    <th>
                        SL
                    </th>

                    <th>
                        Thành tiền
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (
                    Model.ChiTietHoaDons != null
                    &&
                    Model.ChiTietHoaDons.Any()
                )
                {
                    int invoiceIndex = 1;


                    foreach (var item in Model.ChiTietHoaDons)
                    {
                        string invoiceProductName =
                            item.MaSpNavigation?.TenSp
                            ??
                            item.MaComboNavigation?.TenCombo
                            ??
                            "Không xác định";


                        decimal invoiceLineTotal =
                            item.DonGia
                            *
                            item.SoLuong;


                        <tr>

                            <td>
                                @invoiceIndex
                            </td>


                            <td>

                                <strong>
                                    @invoiceProductName
                                </strong>


                                @if (item.MaCombo.HasValue)
                                {
                                    <small>
                                        Combo
                                    </small>
                                }

                            </td>


                            <td>
                                @(item.DonGia.ToString("#,##0"))đ
                            </td>


                            <td>
                                @item.SoLuong
                            </td>


                            <td>
                                @(invoiceLineTotal.ToString("#,##0"))đ
                            </td>

                        </tr>


                        invoiceIndex++;
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5">
                            Không có sản phẩm.
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- =================================================
         SUMMARY
    ================================================== -->

    <div class="admin-invoice-summary">


        <div>

            <span>
                Tạm tính
            </span>

            <strong>
                @((Model.TamTinh ?? 0).ToString("#,##0"))đ
            </strong>

        </div>


        <div>

            <span>
                Giảm giá
            </span>

            <strong>
                -@((Model.GiamGia ?? 0).ToString("#,##0"))đ
            </strong>

        </div>


        <div>

            <span>
                Phí giao hàng
            </span>

            <strong>
                @((Model.PhiGiaoHang ?? 0).ToString("#,##0"))đ
            </strong>

        </div>


        <div class="admin-invoice-grand-total">

            <span>
                TỔNG THANH TOÁN
            </span>

            <strong>
                @((Model.TongTien ?? 0).ToString("#,##0"))đ
            </strong>

        </div>


    </div>


    <!-- =================================================
         FOOTER
    ================================================== -->

    <div class="admin-invoice-footer">

        <strong>
            Cảm ơn quý khách đã lựa chọn Rosalie Coffee!
        </strong>

        <p>
            Hóa đơn được tạo tự động từ hệ thống Rosalie Coffee.
        </p>

    </div>


</div>


<!-- =====================================================
     SCRIPT
===================================================== -->
@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js">
    </script>

    <script src="~/js/staff-order-details.js"
            asp-append-version="true">
    </script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const hideToast =
                    function (toast) {

                        if (!toast) {
                            return;
                        }


                        toast.classList.add(
                            "is-hiding"
                        );


                        setTimeout(
                            function () {

                                toast.remove();

                            },
                            230
                        );

                    };


                document
                    .querySelectorAll(
                        "[data-staff-toast-close]"
                    )
                    .forEach(
                        function (button) {

                            button.addEventListener(
                                "click",
                                function () {

                                    hideToast(
                                        button.closest(
                                            "[data-staff-toast]"
                                        )
                                    );

                                }
                            );

                        }
                    );


                document
                    .querySelectorAll(
                        "[data-staff-toast]"
                    )
                    .forEach(
                        function (toast) {

                            setTimeout(
                                function () {

                                    hideToast(
                                        toast
                                    );

                                },
                                4000
                            );

                        }
                    );

            }
        );

    </script>

}
