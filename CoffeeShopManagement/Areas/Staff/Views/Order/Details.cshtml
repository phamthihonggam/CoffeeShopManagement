                <span>
                    GIAO HÀNG
                </span>

                <h3>
                    Người nhận
                </h3>

            </div>

        </div>


        <div class="admin-order-info-list">


            <div>

                <span>
                    Họ tên
                </span>

                <strong>
                    @receiverName
                </strong>

            </div>


            <div>

                <span>
                    Số điện thoại
                </span>

                <strong>
                    @receiverPhone
                </strong>

            </div>


            <div>

                <span>
                    Khu vực
                </span>

                <strong>
                    @(Model.QuanHuyenGiaoHang ?? "Chưa cập nhật")
                </strong>

            </div>


            <div>

                <span>
                    Địa chỉ giao hàng
                </span>

                <strong>
                    @receiverAddress
                </strong>

            </div>


        </div>

    </div>


    <!-- =================================================
         ORDER INFO
    ================================================== -->

    <div class="admin-order-detail-card">

        <div class="admin-order-detail-title">

            <div class="admin-order-detail-icon">

                <i class="fa-solid fa-receipt"></i>

            </div>


            <div>

                <span>
                    ĐƠN HÀNG
                </span>

                <h3>
                    Thông tin đơn
                </h3>

            </div>

        </div>


        <div class="admin-order-info-list">


            <div>

                <span>
                    Mã đơn
                </span>

                <strong>
                    @($"#HD{Model.MaHd:D5}")
                </strong>

            </div>


            <div>

                <span>
                    Ngày đặt
                </span>

                <strong>

                    @(Model.NgayDat.HasValue
                        ? Model.NgayDat.Value.ToString("dd/MM/yyyy HH:mm")
                        : "Không xác định")

                </strong>

            </div>


            <div>

                <span>
                    Trạng thái
                </span>

                <span class="admin-order-status @statusClass">

                    @(Model.TrangThai ?? "Chưa xác định")

                </span>

            </div>


            <div>

                <span>
                    Phương thức thanh toán
                </span>

                <strong>
                    @(isVnPay ? "VNPAY" : "COD")
                </strong>

            </div>


        </div>

    </div>

</div>


