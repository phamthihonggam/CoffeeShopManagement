            <span>
                Tạm tính
            </span>

            <strong>
                @((Model.TamTinh ?? 0).ToString("#,##0"))đ
            </strong>

        </div>


        <div>

            <span>
                Giảm giá
            </span>

            <strong class="admin-order-discount">
