        <div class="admin-order-detail-title">

            <div class="admin-order-detail-icon">

                <i class="fa-solid fa-motorcycle"></i>

            </div>


            <div>

                <span>
                    GIAO HÀNG
                </span>

                <h3>
                    Nhân viên giao hàng
                </h3>

            </div>

        </div>


        <div class="admin-order-info-list">


            <div>

                <span>
                    Nhân viên
                </span>

                <strong>

                    @(Model.MaTaiKhoanGiaoNavigation != null
                        ? Model.MaTaiKhoanGiaoNavigation.HoTen
