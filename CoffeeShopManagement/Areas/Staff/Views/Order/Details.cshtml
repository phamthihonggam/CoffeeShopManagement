                </strong>

            </div>


            <div>

                <span>
                    Bắt đầu giao
                </span>

                <strong>

                    @(Model.NgayBatDauGiao.HasValue
                        ? Model.NgayBatDauGiao.Value.ToString("dd/MM/yyyy HH:mm")
