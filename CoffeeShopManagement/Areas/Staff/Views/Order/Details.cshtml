                </strong>

            </div>


        </div>

    </div>

</div>


<!-- =====================================================
     CANCEL / REFUND
===================================================== -->
@if (
    !string.IsNullOrWhiteSpace(Model.LyDoHuy)
    ||
    isCancelRequest
    ||
    !string.IsNullOrWhiteSpace(Model.TrangThaiHoanTien)
)
{
    <div class="admin-order-detail-card admin-order-items-card">

        <div class="admin-order-detail-title">

            <div class="admin-order-detail-icon">

                <i class="fa-solid fa-ban"></i>

            </div>


            <div>

                <span>
                    HỦY ĐƠN
                </span>

                <h3>
                    Thông tin hủy và hoàn tiền
                </h3>

            </div>

        </div>


        <div class="admin-order-info-list">


            @if (!string.IsNullOrWhiteSpace(Model.LyDoHuy))
            {
                <div>

                    <span>
                        Lý do hủy
                    </span>

                    <strong>
                        @Model.LyDoHuy
                    </strong>

                </div>
            }


            @if (!string.IsNullOrWhiteSpace(Model.GhiChuHuy))
            {
                <div>

                    <span>
                        Ghi chú
                    </span>

                    <strong>
                        @Model.GhiChuHuy
                    </strong>

                </div>
            }


            <div>

                <span>
                    Ngày yêu cầu hủy
                </span>

                <strong>

                    @(Model.NgayYeuCauHuy.HasValue
                        ? Model.NgayYeuCauHuy.Value.ToString("dd/MM/yyyy HH:mm")
                        : "Chưa có")

                </strong>

            </div>


            <div>

                <span>
                    Trạng thái hoàn tiền
                </span>

                <strong>
                    @(Model.TrangThaiHoanTien ?? "Không có")
                </strong>

            </div>


            @if (
                Model.SoTienHoan.HasValue
                &&
                Model.SoTienHoan.Value > 0
            )
            {
                <div>

                    <span>
                        Số tiền hoàn
                    </span>

                    <strong>
                        @(Model.SoTienHoan.Value.ToString("#,##0"))đ
                    </strong>

                </div>
            }


            @if (Model.NgayHoanTien.HasValue)
            {
                <div>

                    <span>
                        Ngày hoàn tiền
                    </span>

                    <strong>
                        @(Model.NgayHoanTien.Value.ToString("dd/MM/yyyy HH:mm"))
                    </strong>

                </div>
            }


        </div>


        <!-- =================================================
             CANCEL ACTIONS
        ================================================== -->
        @if (isCancelRequest)
        {
            <div class="admin-order-actions">


                <!-- APPROVE CANCEL -->

                <form asp-area="Staff"
                      asp-controller="Order"
                      asp-action="ApproveCancel"
                      method="post"
                      onsubmit="return confirm('Xác nhận duyệt hủy đơn hàng này?');">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="id"
                           value="@Model.MaHd" />


                    <button type="submit"
                            class="admin-order-action-btn danger">

                        <i class="fa-solid fa-check"></i>

                        Duyệt hủy

                    </button>

                </form>


                <!-- REJECT CANCEL -->

                <form asp-area="Staff"
                      asp-controller="Order"
                      asp-action="RejectCancel"
                      method="post"
                      onsubmit="return confirm('Xác nhận từ chối yêu cầu hủy?');">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="id"
                           value="@Model.MaHd" />


                    <button type="submit"
                            class="admin-order-action-btn secondary">

                        <i class="fa-solid fa-xmark"></i>

                        Từ chối hủy

                    </button>

                </form>


            </div>
        }


        <!-- STAFF KHÔNG XÁC NHẬN HOÀN TIỀN -->
        @if (waitingRefund)
        {
            <div class="alert alert-warning mt-3 mb-0">

                <i class="fa-solid fa-circle-info me-2"></i>

                Đơn hàng đã được duyệt hủy và đang chờ
                Admin xác nhận hoàn tiền cho khách.

            </div>
        }

    </div>
}


<!-- =====================================================
     DELIVERY FAILURE
===================================================== -->
@if (!string.IsNullOrWhiteSpace(Model.LyDoGiaoThatBai))
{
    <div class="admin-order-detail-card admin-order-items-card">

        <div class="admin-order-detail-title">

            <div class="admin-order-detail-icon">

                <i class="fa-solid fa-triangle-exclamation"></i>

            </div>


            <div>

                <span>
                    GIAO HÀNG
                </span>

                <h3>
                    Giao hàng thất bại
                </h3>

            </div>

        </div>


        <div class="admin-order-info-list">

            <div>

                <span>
                    Lý do
                </span>

                <strong>
                    @Model.LyDoGiaoThatBai
                </strong>

            </div>

        </div>

    </div>
}


<!-- =====================================================
     PRODUCTS / COMBO
===================================================== -->

<div class="admin-order-detail-card admin-order-items-card">

    <div class="admin-order-detail-title">

        <div class="admin-order-detail-icon">

            <i class="fa-solid fa-bag-shopping"></i>

        </div>


        <div>

            <span>
                SẢN PHẨM
            </span>

            <h3>
                Chi tiết món đã đặt
            </h3>

        </div>

    </div>


    <div class="admin-order-detail-table-wrap">

        <table class="admin-order-detail-table">

            <thead>

                <tr>

                    <th>
                        Sản phẩm
                    </th>

                    <th>
                        Loại
                    </th>

                    <th>
                        Đơn giá
                    </th>

                    <th>
                        Số lượng
                    </th>

                    <th>
                        Thành tiền
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (
                    Model.ChiTietHoaDons != null
                    &&
                    Model.ChiTietHoaDons.Any()
                )
                {
                    foreach (var item in Model.ChiTietHoaDons)
                    {
                        string productName =
                            item.MaSpNavigation?.TenSp
                            ??
                            item.MaComboNavigation?.TenCombo
                            ??
                            "Không xác định";


                        string itemType =
                            item.MaCombo.HasValue
                                ? "Combo"
                                : "Sản phẩm";


                        decimal lineTotal =
                            item.DonGia
                            *
                            item.SoLuong;


                        <tr>

                            <td>

                                <strong class="admin-order-item-name">
                                    @productName
                                </strong>

                            </td>


                            <td>

                                <span class="admin-order-item-type">
                                    @itemType
                                </span>

                            </td>


                            <td>
                                @(item.DonGia.ToString("#,##0"))đ
                            </td>


                            <td>
                                @item.SoLuong
                            </td>


                            <td>

                                <strong class="admin-order-total">
                                    @(lineTotal.ToString("#,##0"))đ
                                </strong>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5">

                            <div class="admin-order-empty">

                                <i class="fa-solid fa-bag-shopping"></i>

                                <h3>
                                    Không có chi tiết sản phẩm
                                </h3>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- =====================================================
     PAYMENT
===================================================== -->

<div class="admin-order-payment-card">

    <div class="admin-order-payment-title">

        <div>

            <span>
                THANH TOÁN
            </span>

            <h3>
