@model CoffeeShopManagement.Models.HoaDon

@{
    ViewData["Title"] = "Chi tiết đơn giao hàng";

    string status =
        Model.TrangThai?.Trim()
        ?? "";

    bool isPaid =
        Model.PhuongThucThanhToan
        == "VNPAY";

    bool canReceive =
        Model.MaTaiKhoanGiao == null
        &&
        status == "Chờ giao hàng";

    bool canStart =
        Model.MaTaiKhoanGiao != null
        &&
        status == "Chờ giao hàng";

    bool canFinish =
        status == "Đang giao hàng";

    bool hasCancelRequest =
        status == "Yêu cầu hủy khi đang giao";
}

<link rel="stylesheet"
      href="~/css/delivery-order.css"
      asp-append-version="true" />


<style>
    /* =========================================================
           ROSALIE - DELIVERY DETAILS SUCCESS MODAL
        ========================================================= */

    .delivery-success-modal {
        border: 0;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(72, 43, 31, 0.22);
    }

    .delivery-success-modal-header {
        padding: 24px 26px 18px;
        border-bottom: 1px solid #eee2da;
        background: #fffaf6;
    }

        .delivery-success-modal-header span {
            display: block;
            margin-bottom: 4px;
            color: #a15f39;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .delivery-success-modal-header .modal-title {
            margin: 0;
            color: #4c2f26;
            font-size: 24px;
            font-weight: 900;
        }

    .delivery-success-modal-body {
        padding: 28px 26px 24px;
        background: #ffffff;
    }

    .delivery-success-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e8f7ed;
        color: #1e9b53;
        font-size: 32px;
    }

    .delivery-success-message {
        margin: 0;
        text-align: center;
        color: #59433a;
        font-size: 16px;
        line-height: 1.7;
    }

        .delivery-success-message strong {
            color: #4c2f26;
            font-weight: 900;
        }

    .delivery-success-note {
        margin-top: 18px;
        padding: 13px 14px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        border: 1px solid #d8ecdf;
        border-radius: 14px;
        background: #f4fbf6;
        color: #477055;
        font-size: 13px;
        line-height: 1.55;
    }

        .delivery-success-note i {
            margin-top: 2px;
            color: #1e9b53;
            font-size: 16px;
        }

    .delivery-success-modal-footer {
        padding: 18px 26px 24px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #eee2da;
        background: #ffffff;
    }

    .delivery-success-cancel,
    .delivery-success-confirm {
        min-width: 132px;
        padding: 11px 18px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease;
    }

    .delivery-success-cancel {
        border: 1px solid #ddcfc6;
        background: #ffffff;
        color: #68483b;
    }

        .delivery-success-cancel:hover {
            background: #f8f1ec;
        }

    .delivery-success-confirm {
        border: 1px solid #1e9b53;
        background: #1e9b53;
        color: #ffffff;
    }

        .delivery-success-confirm:hover {
            background: #178247;
            border-color: #178247;
            transform: translateY(-1px);
        }

    @@media (max-width: 575.98px) {
        .delivery-success-modal-footer {
            flex-direction: column-reverse;
        }

        .delivery-success-cancel,
        .delivery-success-confirm {
            width: 100%;
        }
    }
</style>

<section class="delivery-page">

    <div class="delivery-container">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="delivery-header">

            <div>

                <span class="delivery-label">
                    ROSALIE COFFEE
                </span>

                <h1>
                    Chi tiết đơn #HD@(Model.MaHd.ToString("D5"))
                </h1>

                <p>
                    Kiểm tra thông tin khách hàng,
                    sản phẩm và trạng thái giao hàng.
                </p>

            </div>


            <a asp-area="Delivery"
               asp-controller="Order"
               asp-action="Index"
               class="delivery-btn detail">

                <i class="bi bi-arrow-left"></i>

                Quay lại

            </a>

        </div>


        <!-- =====================================================
             ORDER INFO
        ====================================================== -->

        <div class="delivery-order-card">

            <div class="delivery-order-top">

                <div class="delivery-order-code">

                    <div class="delivery-order-code-icon">

                        <i class="bi bi-receipt"></i>

                    </div>


                    <div>

                        <span>
                            Mã đơn hàng
                        </span>

                        <strong>
                            #HD@(Model.MaHd.ToString("D5"))
                        </strong>

                    </div>

                </div>


                <span class="delivery-status
                    @(status == "Đang giao hàng"
                          ? "shipping"
                          : status == "Chờ giao hàng"
                              ? "waiting"
                              : status == "Yêu cầu hủy khi đang giao"
                                  ? "cancel-request"
                                  : status == "Giao thất bại"
                                      ? "failed"
                                      : "default")">

                    @status

                </span>

            </div>


            <div class="delivery-order-body">

                <!-- RECEIVER -->

                <div class="delivery-order-info">

                    <div class="delivery-info-icon">
                        <i class="bi bi-person"></i>
                    </div>

                    <div>

                        <span>
                            Người nhận
                        </span>

                        <strong>

                            @(string.IsNullOrWhiteSpace(
                                Model.HoTenNguoiNhan
                            )
                                ? Model.MaKhNavigation?.HoTen
                                : Model.HoTenNguoiNhan)

                        </strong>

                    </div>

                </div>


                <!-- PHONE -->

                <div class="delivery-order-info">

                    <div class="delivery-info-icon">
                        <i class="bi bi-telephone"></i>
                    </div>

                    <div>

                        <span>
                            Số điện thoại
                        </span>

                        <strong>

                            @(string.IsNullOrWhiteSpace(
                                Model.DienThoaiNguoiNhan
                            )
                                ? Model.MaKhNavigation?.DienThoai
                                : Model.DienThoaiNguoiNhan)

                        </strong>

                    </div>

                </div>


                <!-- DISTRICT -->

                <div class="delivery-order-info">

                    <div class="delivery-info-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>

                    <div>

                        <span>
                            Khu vực
                        </span>

                        <strong>

                            @(Model.QuanHuyenGiaoHang
                                ?? "Chưa cập nhật")

                        </strong>

                    </div>

                </div>


                <!-- PAYMENT -->

                <div class="delivery-order-info">

                    <div class="delivery-info-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>

                    <div>

                        <span>
                            Thanh toán
                        </span>

                        @if (isPaid)
                        {
                            <strong class="delivery-paid">
                                VNPAY - Đã thanh toán
                            </strong>
                        }
                        else
                        {
                            <strong class="delivery-cod">
                                COD - Thu khi giao
                            </strong>
                        }

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ADDRESS
            ================================================== -->

            <div class="delivery-address">

                <i class="bi bi-pin-map-fill"></i>

                <div>

                    <span>
                        Địa chỉ giao hàng
                    </span>

                    <strong>

                        @(string.IsNullOrWhiteSpace(
                            Model.DiaChiGiaoHang
                        )
                            ? Model.MaKhNavigation?.DiaChi
                            : Model.DiaChiGiaoHang)

                    </strong>

                </div>

            </div>


            <!-- =================================================
                 MONEY
            ================================================== -->

            <div class="delivery-order-money">

                <div>

                    <span>
                        Tổng đơn hàng
                    </span>

                    <strong>

                        @((Model.TongTien ?? 0)
                            .ToString("N0"))đ

                    </strong>

                </div>


                <div class="delivery-collect @(isPaid ? "paid" : "")">

                    <span>
                        Cần thu khách
                    </span>

                    <strong>

                        @(isPaid
                            ? "0đ"
                            : $"{(Model.TongTien ?? 0):N0}đ")

                    </strong>

                </div>

            </div>


            <!-- =================================================
                 DELIVERY TIME
            ================================================== -->

            <div class="delivery-address">

                <i class="bi bi-clock-history"></i>

                <div>

                    <span>
                        Tiến trình giao hàng
                    </span>

                    <strong>

                        Ngày đặt:
                        @(Model.NgayDat?.ToString(
                            "dd/MM/yyyy HH:mm"
                        ) ?? "-")

                    </strong>


                    @if (Model.NgayNhanGiao.HasValue)
                    {
                        <div>
                            Nhận đơn:
                            @(Model.NgayNhanGiao.Value
                                .ToString("dd/MM/yyyy HH:mm"))
                        </div>
                    }


                    @if (Model.NgayBatDauGiao.HasValue)
                    {
                        <div>
                            Bắt đầu giao:
                            @(Model.NgayBatDauGiao.Value
                                .ToString("dd/MM/yyyy HH:mm"))
                        </div>
                    }


                    @if (Model.NgayGiaoThanhCong.HasValue)
                    {
                        <div>
                            Giao thành công:
                            @(Model.NgayGiaoThanhCong.Value
                                .ToString("dd/MM/yyyy HH:mm"))
                        </div>
                    }

                </div>

            </div>


            <!-- =================================================
                 CANCEL REQUEST
            ================================================== -->
            @if (hasCancelRequest)
            {
                <div class="delivery-cancel-request">

                    <div class="delivery-cancel-icon">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                    </div>


                    <div class="delivery-cancel-content">

                        <strong>
                            Khách hàng đang yêu cầu hủy đơn
                        </strong>


                        @if (!string.IsNullOrWhiteSpace(Model.LyDoHuy))
                        {
                            <p>

                                <span>
                                    Lý do:
                                </span>

                                @Model.LyDoHuy

                            </p>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.GhiChuHuy))
                        {
                            <p>

                                <span>
                                    Ghi chú:
                                </span>

                                @Model.GhiChuHuy

                            </p>
                        }


                        @if (Model.NgayYeuCauHuy.HasValue)
                        {
                            <p>

                                <span>
                                    Thời gian yêu cầu:
                                </span>

                                @Model.NgayYeuCauHuy.Value
                                .ToString(
                                "dd/MM/yyyy HH:mm"
                                )

                            </p>
                        }

                    </div>

                </div>
            }


            <!-- =================================================
                 FAILED
            ================================================== -->
            @if (
                            status == "Giao thất bại"
                            &&
                            !string.IsNullOrWhiteSpace(
                                Model.LyDoGiaoThatBai
                            )
                        )
            {
                <div class="delivery-failed-info">

                    <i class="bi bi-x-circle-fill"></i>

                    <div>

                        <strong>
                            Giao hàng thất bại
                        </strong>

                        <p>
                            @Model.LyDoGiaoThatBai
                        </p>

                    </div>

                </div>
            }

        </div>


        <!-- =====================================================
             PRODUCTS
        ====================================================== -->

        <div class="delivery-section"
             style="margin-top:30px;">

            <div class="delivery-section-header">

                <div>

                    <span>
                        SẢN PHẨM
                    </span>

                    <h2>
                        Chi tiết món trong đơn
                    </h2>

                </div>


                <div class="delivery-section-count">

                    @(Model.ChiTietHoaDons?.Count ?? 0) món

                </div>

            </div>


            @if (
                Model.ChiTietHoaDons == null
                ||
                !Model.ChiTietHoaDons.Any()
            )
            {
                <div class="delivery-empty small">

                    <div class="delivery-empty-icon">
                        <i class="bi bi-cup-hot"></i>
                    </div>

                    <h3>
                        Không có sản phẩm
                    </h3>

                </div>
            }
            else
            {
                <div class="delivery-order-list">

                    @foreach (var item in Model.ChiTietHoaDons)
                    {
                        if (
                            item.MaSp.HasValue
                            &&
                            item.MaSpNavigation != null
                        )
                        {
                            var product =
                                item.MaSpNavigation;

                            <div class="delivery-order-card">

                                <div class="delivery-order-body">

                                    <div class="delivery-order-info">

                                        <div class="delivery-info-icon">

                                            <i class="bi bi-cup-hot"></i>

                                        </div>

                                        <div>

                                            <span>
                                                Sản phẩm
                                            </span>

                                            <strong>
                                                @product.TenSp
                                            </strong>

                                        </div>

                                    </div>


                                    <div class="delivery-order-info">

                                        <div class="delivery-info-icon">

                                            <i class="bi bi-box"></i>

                                        </div>

                                        <div>

                                            <span>
                                                Số lượng
                                            </span>

                                            <strong>
                                                @item.SoLuong
                                            </strong>

                                        </div>

                                    </div>


                                    <div class="delivery-order-info">

                                        <div class="delivery-info-icon">

                                            <i class="bi bi-cash"></i>

                                        </div>

                                        <div>

                                            <span>
                                                Đơn giá
                                            </span>

                                            <strong>

                                                @(item.DonGia
                                                    .ToString("N0"))đ

                                            </strong>

                                        </div>

                                    </div>


                                    <div class="delivery-order-info">

                                        <div class="delivery-info-icon">

                                            <i class="bi bi-calculator"></i>

                                        </div>

                                        <div>

                                            <span>
                                                Thành tiền
                                            </span>

                                            <strong>

                                                @((item.DonGia
                                                    * item.SoLuong)
                                                    .ToString("N0"))đ

                                            </strong>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }


                        if (
                            item.MaCombo.HasValue
                            &&
                            item.MaComboNavigation != null
                        )
                        {
                            var combo =
                                item.MaComboNavigation;

                            <div class="delivery-order-card">

                                <div class="delivery-order-body">

                                    <div class="delivery-order-info">

                                        <div class="delivery-info-icon">

                                            <i class="bi bi-gift"></i>

                                        </div>

                                        <div>

                                            <span>
                                                Combo
                                            </span>

                                            <strong>
                                                @combo.TenCombo
                                            </strong>

                                        </div>

                                    </div>


                                    <div class="delivery-order-info">

                                        <div class="delivery-info-icon">

                                            <i class="bi bi-box"></i>

                                        </div>

                                        <div>

                                            <span>
                                                Số lượng
                                            </span>

                                            <strong>
                                                @item.SoLuong
                                            </strong>

                                        </div>

                                    </div>


                                    <div class="delivery-order-info">

                                        <div class="delivery-info-icon">

                                            <i class="bi bi-cash"></i>

                                        </div>

                                        <div>

                                            <span>
                                                Đơn giá
                                            </span>

                                            <strong>

                                                @(item.DonGia
                                                    .ToString("N0"))đ

                                            </strong>

                                        </div>

                                    </div>


                                    <div class="delivery-order-info">

                                        <div class="delivery-info-icon">

                                            <i class="bi bi-calculator"></i>

                                        </div>

                                        <div>

                                            <span>
                                                Thành tiền
                                            </span>

                                            <strong>

                                                @((item.DonGia
                                                    * item.SoLuong)
                                                    .ToString("N0"))đ

                                            </strong>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }
                    }

                </div>
            }

        </div>


        <!-- =====================================================
             ACTIONS
        ====================================================== -->

        <div class="delivery-section">

            <div class="delivery-order-card">

                <div class="delivery-order-actions">


                    @if (canReceive)
                    {
                        <form asp-area="Delivery"
                              asp-controller="Order"
                              asp-action="Receive"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.MaHd" />

                            <button type="submit"
                                    class="delivery-btn receive">

                                <i class="bi bi-hand-index-thumb"></i>

                                Nhận đơn

                            </button>

                        </form>
                    }


                    @if (canStart)
                    {
                        <form asp-area="Delivery"
                              asp-controller="Order"
                              asp-action="StartDelivery"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.MaHd" />

                            <button type="submit"
                                    class="delivery-btn start">

                                <i class="bi bi-truck"></i>

                                Bắt đầu giao

                            </button>

                        </form>
                    }


                    @if (canFinish)
                    {
                        <button type="button"
                                class="delivery-btn success"
                                data-bs-toggle="modal"
                                data-bs-target="#deliveredModal">

                            <i class="bi bi-check-circle-fill"></i>

                            Giao thành công

                        </button>


                        <a asp-area="Delivery"
                           asp-controller="Order"
                           asp-action="Index"
                           class="delivery-btn failed">

                            <i class="bi bi-x-circle"></i>

                            Giao thất bại tại trang danh sách

                        </a>
                    }


                    @if (hasCancelRequest)
                    {
                        <form asp-area="Delivery"
                              asp-controller="Order"
                              asp-action="ConfirmCancelRequest"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.MaHd" />

                            <button type="submit"
                                    class="delivery-btn warning">

                                <i class="bi bi-arrow-return-left"></i>

                                Xác nhận chưa giao

                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     DELIVERED SUCCESS CONFIRM MODAL
========================================================= -->

<div class="modal fade"
     id="deliveredModal"
     tabindex="-1"
     aria-labelledby="deliveredModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delivery-success-modal">

            <div class="modal-header delivery-success-modal-header">

                <div>

                    <span>
                        ROSALIE COFFEE
                    </span>

                    <h5 class="modal-title"
                        id="deliveredModalLabel">

                        Xác nhận giao hàng

                    </h5>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form asp-area="Delivery"
                  asp-controller="Order"
                  asp-action="Delivered"
                  method="post">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       value="@Model.MaHd" />


                <div class="modal-body delivery-success-modal-body">

                    <div class="delivery-success-icon">

                        <i class="bi bi-check-lg"></i>

                    </div>


                    <p class="delivery-success-message">

                        Xác nhận khách hàng đã nhận đơn
                        <strong>
                            #HD@(Model.MaHd.ToString("D5"))
                        </strong>
                        thành công?

                    </p>


                    <div class="delivery-success-note">

                        <i class="bi bi-info-circle-fill"></i>

                        <span>
                            Sau khi xác nhận, đơn hàng sẽ được cập nhật
                            sang trạng thái <strong>Đã giao</strong>.
                        </span>

                    </div>

                </div>


                <div class="modal-footer delivery-success-modal-footer">

                    <button type="button"
                            class="delivery-success-cancel"
                            data-bs-dismiss="modal">

                        Hủy

                    </button>


                    <button type="submit"
                            class="delivery-success-confirm">

                        <i class="bi bi-check-circle-fill"></i>

                        Xác nhận đã giao

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
