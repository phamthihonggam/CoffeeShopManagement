@using CoffeeShopManagement.Models

@{
    ViewData["Title"] = "Đơn giao hàng";

    var availableOrders =
        ViewBag.AvailableOrders as List<HoaDon>
        ?? new List<HoaDon>();

    var myOrders =
        ViewBag.MyOrders as List<HoaDon>
        ?? new List<HoaDon>();
}


<link rel="stylesheet"
      href="~/css/delivery-order.css"
      asp-append-version="true" />


<style>
    /* =========================================================
           ROSALIE - DELIVERY SUCCESS CONFIRM MODAL
        ========================================================= */

    .delivery-success-modal {
        border: 0;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(72, 43, 31, 0.22);
    }

    .delivery-success-modal-header {
        padding: 24px 26px 18px;
        border-bottom: 1px solid #eee2da;
        background: #fffaf6;
    }

        .delivery-success-modal-header span {
            display: block;
            margin-bottom: 4px;
            color: #a15f39;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .delivery-success-modal-header .modal-title {
            margin: 0;
            color: #4c2f26;
            font-size: 24px;
            font-weight: 900;
        }

    .delivery-success-modal-body {
        padding: 28px 26px 24px;
        background: #ffffff;
    }

    .delivery-success-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e8f7ed;
        color: #1e9b53;
        font-size: 32px;
    }

    .delivery-success-message {
        margin: 0;
        text-align: center;
        color: #59433a;
        font-size: 16px;
        line-height: 1.7;
    }

        .delivery-success-message strong {
            color: #4c2f26;
            font-weight: 900;
        }

    .delivery-success-note {
        margin-top: 18px;
        padding: 13px 14px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        border: 1px solid #d8ecdf;
        border-radius: 14px;
        background: #f4fbf6;
        color: #477055;
        font-size: 13px;
        line-height: 1.55;
    }

        .delivery-success-note i {
            margin-top: 2px;
            color: #1e9b53;
            font-size: 16px;
        }

    .delivery-success-modal-footer {
        padding: 18px 26px 24px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #eee2da;
        background: #ffffff;
    }

    .delivery-success-cancel,
    .delivery-success-confirm {
        min-width: 132px;
        padding: 11px 18px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease;
    }

    .delivery-success-cancel {
        border: 1px solid #ddcfc6;
        background: #ffffff;
        color: #68483b;
    }

        .delivery-success-cancel:hover {
            background: #f8f1ec;
        }

    .delivery-success-confirm {
        border: 1px solid #1e9b53;
        background: #1e9b53;
        color: #ffffff;
    }

        .delivery-success-confirm:hover {
            background: #178247;
            border-color: #178247;
            transform: translateY(-1px);
        }

    @@media (max-width: 575.98px) {
        .delivery-success-modal-footer {
            flex-direction: column-reverse;
        }

        .delivery-success-cancel,
        .delivery-success-confirm {
            width: 100%;
        }
    }
</style>


<section class="delivery-page">

    <div class="delivery-container">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="delivery-header">

            <div>

                <span class="delivery-label">
                    ROSALIE COFFEE
                </span>

                <h1>
                    Quản lý giao hàng
                </h1>

                <p>
                    Theo dõi và cập nhật trạng thái các đơn hàng
                    được giao đến khách hàng.
                </p>

            </div>


            <div class="delivery-user">

                <div class="delivery-user-icon">

                    <i class="bi bi-truck"></i>

                </div>


                <div>

                    <span>
                        Nhân viên giao hàng
                    </span>

                    <strong>
                        @User.Identity?.Name
                    </strong>

                </div>

            </div>

        </div>



        <!-- =====================================================
             SUMMARY
        ====================================================== -->

        <div class="delivery-summary-grid">


            <!-- AVAILABLE -->

            <div class="delivery-summary-card">

                <div class="delivery-summary-icon available">

                    <i class="bi bi-box-seam"></i>

                </div>


                <div>

                    <span>
                        Đơn đang chờ nhận
                    </span>

                    <strong>
                        @availableOrders.Count
                    </strong>

                </div>

            </div>


            <!-- MY ORDERS -->

            <div class="delivery-summary-card">

                <div class="delivery-summary-icon shipping">

                    <i class="bi bi-truck"></i>

                </div>


                <div>

                    <span>
                        Đơn của tôi
                    </span>

                    <strong>
                        @myOrders.Count
                    </strong>

                </div>

            </div>


            <!-- SHIPPING -->

            <div class="delivery-summary-card">

                <div class="delivery-summary-icon processing">

                    <i class="bi bi-geo-alt"></i>

                </div>


                <div>

                    <span>
                        Đang giao
                    </span>

                    <strong>

                        @myOrders.Count(
                            x =>
                                x.TrangThai
                                == "Đang giao hàng"
                        )

                    </strong>

                </div>

            </div>


            <!-- CANCEL REQUEST -->

            <div class="delivery-summary-card">

                <div class="delivery-summary-icon cancel">

                    <i class="bi bi-exclamation-triangle"></i>

                </div>


                <div>

                    <span>
                        Yêu cầu hủy
                    </span>

                    <strong>

                        @myOrders.Count(
                            x =>
                                x.TrangThai
                                == "Yêu cầu hủy khi đang giao"
                        )

                    </strong>

                </div>

            </div>

        </div>



        <!-- =====================================================
             MY ORDERS
        ====================================================== -->

        <div class="delivery-section">

            <div class="delivery-section-header">

                <div>

                    <span>
                        ĐƠN CỦA TÔI
                    </span>

                    <h2>
                        Đơn hàng đang phụ trách
                    </h2>

                </div>


                <div class="delivery-section-count">

                    @myOrders.Count đơn

                </div>

            </div>


            @if (!myOrders.Any())
            {
                <div class="delivery-empty">

                    <div class="delivery-empty-icon">

                        <i class="bi bi-truck"></i>

                    </div>


                    <h3>
                        Chưa có đơn giao hàng
                    </h3>


                    <p>
                        Bạn chưa nhận đơn hàng nào.
                        Hãy chọn một đơn trong danh sách bên dưới.
                    </p>

                </div>
            }
            else
            {
                <div class="delivery-order-list">


                    @foreach (var order in myOrders)
                    {
                        string status =
                            order.TrangThai?.Trim()
                            ?? "";


                        string statusClass =
                            status == "Đang giao hàng"
                                ? "shipping"

                                : status == "Chờ giao hàng"
                                    ? "waiting"

                                    : status == "Yêu cầu hủy khi đang giao"
                                        ? "cancel-request"

                                        : status == "Giao thất bại"
                                            ? "failed"

                                            : "default";


                        bool isPaid =
                            order.PhuongThucThanhToan
                            == "VNPAY";


                        <div class="delivery-order-card">


                            <!-- =================================================
                                 TOP
                            ================================================== -->

                            <div class="delivery-order-top">

                                <div class="delivery-order-code">

                                    <div class="delivery-order-code-icon">

                                        <i class="bi bi-receipt"></i>

                                    </div>


                                    <div>

                                        <span>
                                            Mã đơn
                                        </span>

                                        <strong>

                                            #HD@(order.MaHd.ToString("D5"))

                                        </strong>

                                    </div>

                                </div>


                                <span class="delivery-status @statusClass">

                                    @status

                                </span>

                            </div>



                            <!-- =================================================
                                 BODY
                            ================================================== -->

                            <div class="delivery-order-body">


                                <!-- RECEIVER -->

                                <div class="delivery-order-info">

                                    <div class="delivery-info-icon">

                                        <i class="bi bi-person"></i>

                                    </div>


                                    <div>

                                        <span>
                                            Người nhận
                                        </span>

                                        <strong>

                                            @(string.IsNullOrWhiteSpace(
                                                order.HoTenNguoiNhan
                                            )
                                                ? order.MaKhNavigation?.HoTen
                                                : order.HoTenNguoiNhan)

                                        </strong>

                                    </div>

                                </div>


                                <!-- PHONE -->

                                <div class="delivery-order-info">

                                    <div class="delivery-info-icon">

                                        <i class="bi bi-telephone"></i>

                                    </div>


                                    <div>

                                        <span>
                                            Số điện thoại
                                        </span>

                                        <strong>

                                            @(string.IsNullOrWhiteSpace(
                                                order.DienThoaiNguoiNhan
                                            )
                                                ? order.MaKhNavigation?.DienThoai
                                                : order.DienThoaiNguoiNhan)

                                        </strong>

                                    </div>

                                </div>


                                <!-- DISTRICT -->

                                <div class="delivery-order-info">

                                    <div class="delivery-info-icon">

                                        <i class="bi bi-geo-alt"></i>

                                    </div>


                                    <div>

                                        <span>
                                            Khu vực
                                        </span>

                                        <strong>

                                            @(order.QuanHuyenGiaoHang
                                                ?? "Chưa cập nhật")

                                        </strong>

                                    </div>

                                </div>


                                <!-- PAYMENT -->

                                <div class="delivery-order-info">

                                    <div class="delivery-info-icon">

                                        <i class="bi bi-wallet2"></i>

                                    </div>


                                    <div>

                                        <span>
                                            Thanh toán
                                        </span>

                                        @if (isPaid)
                                        {
                                            <strong class="delivery-paid">

                                                VNPAY - Đã thanh toán

                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="delivery-cod">

                                                COD - Thu khi giao

                                            </strong>
                                        }

                                    </div>

                                </div>

                            </div>



                            <!-- =================================================
                                 ADDRESS
                            ================================================== -->

                            <div class="delivery-address">

                                <i class="bi bi-pin-map-fill"></i>


                                <div>

                                    <span>
                                        Địa chỉ giao hàng
                                    </span>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(
                                            order.DiaChiGiaoHang
                                        )
                                            ? order.MaKhNavigation?.DiaChi
                                            : order.DiaChiGiaoHang)

                                    </strong>

                                </div>

                            </div>



                            <!-- =================================================
                                 TOTAL
                            ================================================== -->

                            <div class="delivery-order-money">

                                <div>

                                    <span>
                                        Tổng đơn hàng
                                    </span>

                                    <strong>

                                        @((order.TongTien ?? 0)
                                            .ToString("N0"))đ

                                    </strong>

                                </div>


                                @if (!isPaid)
                                {
                                    <div class="delivery-collect">

                                        <span>
                                            Cần thu khách
                                        </span>

                                        <strong>

                                            @((order.TongTien ?? 0)
                                                .ToString("N0"))đ

                                        </strong>

                                    </div>
                                }
                                else
                                {
                                    <div class="delivery-collect paid">

                                        <span>
                                            Cần thu khách
                                        </span>

                                        <strong>
                                            0đ
                                        </strong>

                                    </div>
                                }

                            </div>



                            <!-- =================================================
                                 CANCEL REQUEST
                            ================================================== -->
                            @if (
                                                            status
                                                            == "Yêu cầu hủy khi đang giao"
                                                        )
                            {
                                <div class="delivery-cancel-request">

                                    <div class="delivery-cancel-icon">

                                        <i class="bi bi-exclamation-triangle-fill"></i>

                                    </div>


                                    <div class="delivery-cancel-content">

                                        <strong>
                                            Khách hàng yêu cầu hủy đơn
                                        </strong>


                                        @if (!string.IsNullOrWhiteSpace(order.LyDoHuy))
                                        {
                                            <p>

                                                <span>
                                                    Lý do:
                                                </span>

                                                @order.LyDoHuy

                                            </p>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(order.GhiChuHuy))
                                        {
                                            <p>

                                                <span>
                                                    Ghi chú:
                                                </span>

                                                @order.GhiChuHuy

                                            </p>
                                        }


                                        @if (order.NgayYeuCauHuy.HasValue)
                                        {
                                            <p>

                                                <span>
                                                    Thời gian:
                                                </span>

                                                @order.NgayYeuCauHuy.Value
                                                .ToString(
                                                "dd/MM/yyyy HH:mm"
                                                )

                                            </p>
                                        }

                                    </div>

                                </div>
                            }



                            <!-- =================================================
                                 FAILED INFO
                            ================================================== -->
                            @if (
                                                            status == "Giao thất bại"
                                                            &&
                                                            !string.IsNullOrWhiteSpace(
                                                                order.LyDoGiaoThatBai
                                                            )
                                                        )
                            {
                                <div class="delivery-failed-info">

                                    <i class="bi bi-x-circle-fill"></i>

                                    <div>

                                        <strong>
                                            Giao hàng thất bại
                                        </strong>

                                        <p>
                                            @order.LyDoGiaoThatBai
                                        </p>

                                    </div>

                                </div>
                            }



                            <!-- =================================================
                                 ACTION
                            ================================================== -->

                            <div class="delivery-order-actions">


                                <!-- DETAIL -->

                                <a asp-area="Delivery"
                                   asp-controller="Order"
                                   asp-action="Details"
                                   asp-route-id="@order.MaHd"
                                   class="delivery-btn detail">

                                    <i class="bi bi-eye"></i>

                                    Chi tiết

                                </a>



                                <!-- START DELIVERY -->
                                @if (
                                                                    status == "Chờ giao hàng"
                                                                )
                                {
                                    <form asp-area="Delivery"
                                          asp-controller="Order"
                                          asp-action="StartDelivery"
                                          method="post">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@order.MaHd" />


                                        <button type="submit"
                                                class="delivery-btn start">

                                            <i class="bi bi-truck"></i>

                                            Bắt đầu giao

                                        </button>

                                    </form>
                                }



                                <!-- SHIPPING ACTION -->
                                @if (
                                                                    status == "Đang giao hàng"
                                                                )
                                {
                                    <!-- SUCCESS -->

                                    <button type="button"
                                            class="delivery-btn success"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deliveredModal"
                                            data-order-id="@order.MaHd"
                                            data-order-code="#HD@(order.MaHd.ToString("D5"))">

                                        <i class="bi bi-check-circle-fill"></i>

                                        Giao thành công

                                    </button>



                                    <!-- FAILED -->

                                    <button type="button"
                                            class="delivery-btn failed"
                                            data-bs-toggle="modal"
                                            data-bs-target="#failedModal"
                                            data-order-id="@order.MaHd"
                                            data-order-code="#HD@(order.MaHd.ToString("D5"))">

                                        <i class="bi bi-x-circle"></i>

                                        Giao thất bại

                                    </button>
                                }



                                <!-- CANCEL REQUEST -->
                                @if (
                                                                    status ==
                                                                    "Yêu cầu hủy khi đang giao"
                                                                )
                                {
                                    <form asp-area="Delivery"
                                          asp-controller="Order"
                                          asp-action="ConfirmCancelRequest"
                                          method="post">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="id"
                                               value="@order.MaHd" />


                                        <button type="submit"
                                                class="delivery-btn warning">

                                            <i class="bi bi-arrow-return-left"></i>

                                            Xác nhận chưa giao

                                        </button>

                                    </form>
                                }


                            </div>

                        </div>
                    }


                </div>
            }

        </div>



        <!-- =====================================================
             AVAILABLE ORDERS
        ====================================================== -->

        <div class="delivery-section delivery-available-section">

            <div class="delivery-section-header">

                <div>

                    <span>
                        ĐƠN MỚI
                    </span>

                    <h2>
                        Đơn hàng chờ giao
                    </h2>

                </div>


                <div class="delivery-section-count">

                    @availableOrders.Count đơn

                </div>

            </div>


            @if (!availableOrders.Any())
            {
                <div class="delivery-empty small">

                    <div class="delivery-empty-icon">

                        <i class="bi bi-box-seam"></i>

                    </div>


                    <h3>
                        Hiện chưa có đơn mới
                    </h3>


                    <p>
                        Các đơn sẵn sàng giao sẽ xuất hiện tại đây.
                    </p>

                </div>
            }
            else
            {
                <div class="delivery-available-grid">


                    @foreach (var order in availableOrders)
                    {
                        bool isPaid =
                            order.PhuongThucThanhToan
                            == "VNPAY";


                        <div class="delivery-available-card">


                            <div class="delivery-available-top">

                                <div>

                                    <span>
                                        Đơn hàng
                                    </span>

                                    <strong>

                                        #HD@(order.MaHd.ToString("D5"))

                                    </strong>

                                </div>


                                <span class="delivery-payment-badge @(isPaid ? "paid" : "cod")">

                                    @(isPaid
                                        ? "VNPAY"
                                        : "COD")

                                </span>

                            </div>


                            <div class="delivery-available-info">

                                <div>

                                    <i class="bi bi-person"></i>

                                    <span>

                                        @(string.IsNullOrWhiteSpace(
                                            order.HoTenNguoiNhan
                                        )
                                            ? order.MaKhNavigation?.HoTen
                                            : order.HoTenNguoiNhan)

                                    </span>

                                </div>


                                <div>

                                    <i class="bi bi-geo-alt"></i>

                                    <span>

                                        @(order.QuanHuyenGiaoHang
                                            ?? "Chưa cập nhật")

                                    </span>

                                </div>


                                <div>

                                    <i class="bi bi-cash-stack"></i>

                                    <span>

                                        @((order.TongTien ?? 0)
                                            .ToString("N0"))đ

                                    </span>

                                </div>

                            </div>


                            <div class="delivery-available-address">

                                @(string.IsNullOrWhiteSpace(
                                    order.DiaChiGiaoHang
                                )
                                    ? order.MaKhNavigation?.DiaChi
                                    : order.DiaChiGiaoHang)

                            </div>


                            <div class="delivery-available-actions">


                                <a asp-area="Delivery"
                                   asp-controller="Order"
                                   asp-action="Details"
                                   asp-route-id="@order.MaHd"
                                   class="delivery-btn detail">

                                    <i class="bi bi-eye"></i>

                                    Xem

                                </a>


                                <form asp-area="Delivery"
                                      asp-controller="Order"
                                      asp-action="Receive"
                                      method="post">

                                    @Html.AntiForgeryToken()


                                    <input type="hidden"
                                           name="id"
                                           value="@order.MaHd" />


                                    <button type="submit"
                                            class="delivery-btn receive">

                                        <i class="bi bi-hand-index-thumb"></i>

                                        Nhận đơn

                                    </button>

                                </form>

                            </div>

                        </div>
                    }


                </div>
            }

        </div>


    </div>

</section>



<!-- =========================================================
     DELIVERED SUCCESS CONFIRM MODAL
========================================================= -->

<div class="modal fade"
     id="deliveredModal"
     tabindex="-1"
     aria-labelledby="deliveredModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delivery-success-modal">

            <div class="modal-header delivery-success-modal-header">

                <div>

                    <span>
                        ROSALIE COFFEE
                    </span>

                    <h5 class="modal-title"
                        id="deliveredModalLabel">

                        Xác nhận giao hàng

                    </h5>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form asp-area="Delivery"
                  asp-controller="Order"
                  asp-action="Delivered"
                  method="post"
                  id="deliveredForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       id="deliveredOrderId" />


                <div class="modal-body delivery-success-modal-body">

                    <div class="delivery-success-icon">

                        <i class="bi bi-check-lg"></i>

                    </div>


                    <p class="delivery-success-message">

                        Xác nhận khách hàng đã nhận đơn
                        <strong id="deliveredOrderCode">
                            #HD00000
                        </strong>
                        thành công?

                    </p>


                    <div class="delivery-success-note">

                        <i class="bi bi-info-circle-fill"></i>

                        <span>
                            Sau khi xác nhận, đơn hàng sẽ được cập nhật
                            sang trạng thái <strong>Đã giao</strong>.
                        </span>

                    </div>

                </div>


                <div class="modal-footer delivery-success-modal-footer">

                    <button type="button"
                            class="delivery-success-cancel"
                            data-bs-dismiss="modal">

                        Hủy

                    </button>


                    <button type="submit"
                            class="delivery-success-confirm">

                        <i class="bi bi-check-circle-fill"></i>

                        Xác nhận đã giao

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     FAILED DELIVERY MODAL
========================================================= -->

<div class="modal fade"
     id="failedModal"
     tabindex="-1"
     aria-labelledby="failedModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delivery-failed-modal">


            <div class="modal-header delivery-failed-modal-header">

                <div>

                    <span>
                        ROSALIE COFFEE
                    </span>

                    <h5 class="modal-title"
                        id="failedModalLabel">

                        Giao hàng thất bại

                    </h5>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form asp-area="Delivery"
                  asp-controller="Order"
                  asp-action="Failed"
                  method="post"
                  id="failedForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       id="failedOrderId" />


                <div class="modal-body delivery-failed-modal-body">


                    <div class="delivery-failed-order">

                        <i class="bi bi-receipt"></i>

                        <div>

                            <span>
                                Đơn hàng
                            </span>

                            <strong id="failedOrderCode">

                                #HD00000

                            </strong>

                        </div>

                    </div>


                    <div class="delivery-failed-warning">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                        <span>
                            Hãy chọn hoặc nhập chính xác lý do
                            không thể giao hàng cho khách.
                        </span>

                    </div>


                    <div class="delivery-modal-field">

                        <label for="failedReasonSelect">

                            Lý do giao thất bại

                            <span>
                                *
                            </span>

                        </label>


                        <select id="failedReasonSelect">

                            <option value="">
                                -- Chọn lý do --
                            </option>

                            <option value="Không liên lạc được với khách hàng">
                                Không liên lạc được với khách hàng
                            </option>

                            <option value="Khách hàng không có mặt">
                                Khách hàng không có mặt
                            </option>

                            <option value="Khách từ chối nhận hàng">
                                Khách từ chối nhận hàng
                            </option>

                            <option value="Địa chỉ giao hàng không chính xác">
                                Địa chỉ giao hàng không chính xác
                            </option>

                            <option value="Không thể tiếp cận địa chỉ giao hàng">
                                Không thể tiếp cận địa chỉ giao hàng
                            </option>

                            <option value="Khác">
                                Khác
                            </option>

                        </select>

                    </div>


                    <div class="delivery-modal-field"
                         id="failedOtherField"
                         style="display:none;">

                        <label for="failedOtherReason">

                            Lý do khác

                        </label>


                        <textarea id="failedOtherReason"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Nhập lý do giao thất bại..."></textarea>

                    </div>


                    <!-- value gửi controller -->

                    <input type="hidden"
                           name="lyDo"
                           id="failedReasonValue" />


                    <div class="delivery-modal-error"
                         id="failedModalError">
                    </div>

                </div>


                <div class="modal-footer delivery-failed-modal-footer">

                    <button type="button"
                            class="delivery-modal-back"
                            data-bs-dismiss="modal">

                        Quay lại

                    </button>


                    <button type="submit"
                            class="delivery-modal-confirm">

                        <i class="bi bi-x-circle"></i>

                        Xác nhận giao thất bại

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                // =============================================
                // DELIVERED SUCCESS MODAL
                // =============================================

                const deliveredModal =
                    document.getElementById(
                        "deliveredModal"
                    );


                const deliveredOrderId =
                    document.getElementById(
                        "deliveredOrderId"
                    );


                const deliveredOrderCode =
                    document.getElementById(
                        "deliveredOrderCode"
                    );


                deliveredModal?.addEventListener(
                    "show.bs.modal",
                    function(event) {

                        const button =
                            event.relatedTarget;


                        if (!button) {
                            return;
                        }


                        deliveredOrderId.value =
                            button.getAttribute(
                                "data-order-id"
                            ) ?? "";


                        deliveredOrderCode.textContent =
                            button.getAttribute(
                                "data-order-code"
                            ) ?? "#HD00000";

                    }
                );


                // =============================================
                // FAILED MODAL ELEMENT
                // =============================================

                const modal =
                    document.getElementById(
                        "failedModal"
                    );


                const orderId =
                    document.getElementById(
                        "failedOrderId"
                    );


                const orderCode =
                    document.getElementById(
                        "failedOrderCode"
                    );


                const select =
                    document.getElementById(
                        "failedReasonSelect"
                    );


                const otherField =
                    document.getElementById(
                        "failedOtherField"
                    );


                const otherReason =
                    document.getElementById(
                        "failedOtherReason"
                    );


                const reasonValue =
                    document.getElementById(
                        "failedReasonValue"
                    );


                const error =
                    document.getElementById(
                        "failedModalError"
                    );


                const form =
                    document.getElementById(
                        "failedForm"
                    );


                // =============================================
                // OPEN MODAL
                // =============================================

                modal?.addEventListener(
                    "show.bs.modal",
                    function(event) {

                        const button =
                            event.relatedTarget;


                        if (!button) {
                            return;
                        }


                        orderId.value =
                            button.getAttribute(
                                "data-order-id"
                            ) ?? "";


                        orderCode.textContent =
                            button.getAttribute(
                                "data-order-code"
                            ) ?? "";


                        select.value =
                            "";


                        otherReason.value =
                            "";


                        reasonValue.value =
                            "";


                        otherField.style.display =
                            "none";


                        error.textContent =
                            "";

                    }
                );


                // =============================================
                // SELECT REASON
                // =============================================

                select?.addEventListener(
                    "change",
                    function() {

                        error.textContent =
                            "";


                        if (
                            this.value === "Khác"
                        ) {

                            otherField.style.display =
                                "block";

                            reasonValue.value =
                                "";

                            otherReason.focus();

                        }
                        else {

                            otherField.style.display =
                                "none";

                            otherReason.value =
                                "";

                            reasonValue.value =
                                this.value;

                        }

                    }
                );


                // =============================================
                // OTHER REASON
                // =============================================

                otherReason?.addEventListener(
                    "input",
                    function() {

                        if (
                            select.value === "Khác"
                        ) {

                            reasonValue.value =
                                this.value.trim();

                        }

                    }
                );


                // =============================================
                // VALIDATE
                // =============================================

                form?.addEventListener(
                    "submit",
                    function(event) {

                        error.textContent =
                            "";


                        if (!select.value) {

                            event.preventDefault();

                            error.textContent =
                                "Vui lòng chọn lý do giao thất bại.";

                            return;
                        }


                        if (
                            select.value === "Khác"
                            &&
                            !otherReason.value.trim()
                        ) {

                            event.preventDefault();

                            error.textContent =
                                "Vui lòng nhập lý do giao thất bại.";

                            otherReason.focus();

                            return;
                        }


                        if (
                            select.value === "Khác"
                        ) {

                            reasonValue.value =
                                otherReason.value.trim();

                        }
                        else {

                            reasonValue.value =
                                select.value;

                        }

                    }
                );

            }
        );

    </script>

}