@{
    ViewData["Title"] = "Đánh giá combo";

    int maHd =
        ViewBag.MaHd ?? 0;

    int maCombo =
        ViewBag.MaCombo ?? 0;

    string tenCombo =
        ViewBag.TenCombo as string
        ?? "Combo Rosalie";

    string hinhAnh =
        ViewBag.HinhAnh as string
        ?? "";

    decimal giaBan =
        ViewBag.GiaBan != null
            ? Convert.ToDecimal(ViewBag.GiaBan)
            : 0;
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/combo-review.css"
          asp-append-version="true" />

}


<section class="combo-review-page">

    <div class="combo-review-container">

        <a asp-controller="Account"
           asp-action="OrderHistory"
           class="combo-review-back">

            <i class="bi bi-arrow-left"></i>

            Quay lại đơn hàng

        </a>


        <div class="combo-review-card">

            <!-- =========================================
                 COMBO
            ========================================== -->

            <div class="combo-review-product">

                <span class="combo-review-label">
                    ROSALIE COMBO
                </span>


                <div class="combo-review-image">

                    <img src="~/images/combo/@hinhAnh"
                         asp-append-version="true"
                         alt="@tenCombo" />

                </div>


                <div class="combo-review-product-info">

                    <span>
                        Đơn hàng #HD@maHd.ToString("D5")
                    </span>

                    <h1>
                        @tenCombo
                    </h1>

                    <strong>
                        @giaBan.ToString("N0")đ
                    </strong>

                </div>

            </div>


            <!-- =========================================
                 FORM
            ========================================== -->

            <div class="combo-review-form-wrap">

                <span class="combo-review-eyebrow">
                    ĐÁNH GIÁ COMBO
                </span>

                <h2>
                    Bạn thấy combo này thế nào?
                </h2>

                <p class="combo-review-intro">
                    Chia sẻ trải nghiệm thật của bạn để giúp
                    những khách hàng khác lựa chọn dễ dàng hơn.
                </p>


                <form asp-controller="Review"
                      asp-action="CreateCombo"
                      method="post"
                      id="comboReviewForm">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="maHd"
                           value="@maHd" />

                    <input type="hidden"
                           name="maCombo"
                           value="@maCombo" />


                    <!-- =================================
                         STARS
                    ================================== -->

                    <div class="combo-review-field">

                        <label>
                            Mức độ hài lòng
                            <span>*</span>
                        </label>


                        <div class="combo-review-stars"
                             id="comboReviewStars">

                            @for (int star = 1; star <= 5; star++)
                            {
                                <button type="button"
                                        class="combo-review-star"
                                        data-star="@star"
                                        aria-label="@star sao">

                                    <i class="bi bi-star-fill"></i>

                                </button>
                            }

                        </div>


                        <input type="hidden"
                               name="soSao"
                               id="comboReviewRating"
                               value="0" />


                        <div id="comboReviewRatingText"
                             class="combo-review-rating-text">

                            Chọn số sao bạn muốn đánh giá

                        </div>

                    </div>


                    <!-- =================================
                         COMMENT
                    ================================== -->

                    <div class="combo-review-field">

                        <label for="comboReviewContent">
                            Nhận xét của bạn
                        </label>


                        <div class="combo-review-textarea">

                            <textarea id="comboReviewContent"
                                      name="noiDung"
                                      maxlength="1000"
                                      rows="6"
                                      placeholder="Ví dụ: Đồ uống thơm, bánh ngon, combo rất đáng thử..."></textarea>

                            <span id="comboReviewCount">
                                0 / 1000
                            </span>

                        </div>

                    </div>


                    <div id="comboReviewError"
                         class="combo-review-error">
                    </div>


                    <!-- =================================
                         ACTION
                    ================================== -->

                    <div class="combo-review-actions">

                        <a asp-controller="Account"
                           asp-action="OrderHistory"
                           class="combo-review-cancel">

                            Hủy

                        </a>


                        <button type="submit"
                                class="combo-review-submit">

                            <i class="bi bi-send-fill"></i>

                            Gửi đánh giá

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const stars =
                    Array.from(
                        document.querySelectorAll(
                            ".combo-review-star"
                        )
                    );

                const ratingInput =
                    document.getElementById(
                        "comboReviewRating"
                    );

                const ratingText =
                    document.getElementById(
                        "comboReviewRatingText"
                    );

                const textarea =
                    document.getElementById(
                        "comboReviewContent"
                    );

                const counter =
                    document.getElementById(
                        "comboReviewCount"
                    );

                const error =
                    document.getElementById(
                        "comboReviewError"
                    );

                const form =
                    document.getElementById(
                        "comboReviewForm"
                    );


                const messages = {
                    1: "Chưa hài lòng",
                    2: "Tạm ổn",
                    3: "Khá tốt",
                    4: "Rất tốt",
                    5: "Tuyệt vời"
                };


                function paintStars(
                    rating
                ) {

                    stars.forEach(
                        function (button) {

                            const value =
                                Number(
                                    button.dataset.star
                                );

                            button.classList.toggle(
                                "active",
                                value <= rating
                            );
                        }
                    );
                }


                stars.forEach(
                    function (button) {

                        button.addEventListener(
                            "mouseenter",
                            function () {

                                paintStars(
                                    Number(
                                        this.dataset.star
                                    )
                                );
                            }
                        );


                        button.addEventListener(
                            "mouseleave",
                            function () {

                                paintStars(
                                    Number(
                                        ratingInput.value
                                    )
                                );
                            }
                        );


                        button.addEventListener(
                            "click",
                            function () {

                                const rating =
                                    Number(
                                        this.dataset.star
                                    );


                                ratingInput.value =
                                    rating;


                                paintStars(
                                    rating
                                );


                                ratingText.textContent =
                                    `${rating}/5 · ${messages[rating]}`;


                                error.textContent =
                                    "";
                            }
                        );
                    }
                );


                textarea?.addEventListener(
                    "input",
                    function () {

                        counter.textContent =
                            `${this.value.length} / 1000`;
                    }
                );


                form?.addEventListener(
                    "submit",
                    function (event) {

                        if (
                            Number(
                                ratingInput.value
                            ) < 1
                        ) {

                            event.preventDefault();

                            error.textContent =
                                "Vui lòng chọn số sao trước khi gửi đánh giá.";

                            stars[0]
                                ?.focus();
                        }
                    }
                );

            }
        );

    </script>

}
