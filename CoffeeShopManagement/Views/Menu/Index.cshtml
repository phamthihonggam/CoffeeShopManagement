@model List<CoffeeShopManagement.ViewModels.MenuLandingVM>

@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShopManagement.SharedResource> T

@{
    ViewData["Title"] = T["MenuPageTitle"];
}

<link rel="stylesheet"
      href="~/css/menu-landing.css"
      asp-append-version="true" />


<!-- =====================================================
     COFFEE
     CATEGORY = 1
     IMAGE LEFT - TEXT RIGHT
===================================================== -->

<section class="coffee-banner">

    <div class="container">

        <div class="coffee-wrapper">


            <!-- IMAGE -->
            <div class="coffee-left">

                <img src="~/images/category/coffee.png"
                     asp-append-version="true"
                     alt="Coffee" />

            </div>


            <!-- CONTENT -->
            <div class="coffee-right">

                <div class="coffee-title">

                    <div class="coffee-icon">

                        <i class="bi bi-cup-hot-fill"></i>

                    </div>

                    <h2>
                        @T["MenuCoffeeTitle"]
                    </h2>

                </div>


                <p>
                    @T["MenuCoffeeDescription"]
                </p>


                <a asp-controller="Menu"
                   asp-action="Products"
                   asp-route-category="1"
                   class="btn-coffee">

                    @T["ExploreNow"]

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</section>


