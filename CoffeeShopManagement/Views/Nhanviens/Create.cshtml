@model CoffeeShopManagement.Models.NhanVien

<h2>➕ Thêm nhân viên</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Họ tên</label>
        <input asp-for="HoTen" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Điện thoại</label>
        <input asp-for="DienThoai" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Tên đăng nhập</label>
        <input asp-for="TenDangNhap" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mật khẩu</label>
        <input asp-for="MatKhau" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Chức vụ</label>
        <input asp-for="ChucVu" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Lưu
    </button>

</form>