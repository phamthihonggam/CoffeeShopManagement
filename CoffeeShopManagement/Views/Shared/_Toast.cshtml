<!-- =========================================================
     ROSALIE GLOBAL TOAST
========================================================= -->

<div id="rosalieToastContainer"
     class="rosalie-toast-container"
     aria-live="polite"
     aria-atomic="true">

    <div id="rosalieToast"
         class="rosalie-toast"
         role="alert">

        <!-- ICON -->

        <div id="rosalieToastIcon"
             class="rosalie-toast-icon">

            <i class="fa-solid fa-check"></i>

        </div>


        <!-- CONTENT -->

        <div class="rosalie-toast-content">

            <div id="rosalieToastTitle"
                 class="rosalie-toast-title">

                Thành công

            </div>


            <div id="rosalieToastMessage"
                 class="rosalie-toast-message">
            </div>

        </div>


        <!-- CLOSE -->

        <button type="button"
                id="rosalieToastClose"
                class="rosalie-toast-close"
                aria-label="Đóng thông báo">

            <i class="fa-solid fa-xmark"></i>

        </button>


        <!-- PROGRESS -->

        <div id="rosalieToastProgress"
             class="rosalie-toast-progress">
        </div>

    </div>

</div>