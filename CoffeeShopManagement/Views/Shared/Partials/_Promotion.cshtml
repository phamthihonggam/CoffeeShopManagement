@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShopManagement.SharedResource> T

<div class="promotion-title">

    <span class="promotion-gallery-label">
        <i class="fa-solid fa-mug-hot"></i>
        @T["GalleryLabel"]
    </span>

    <h2>
        @T["GalleryTitle"]
    </h2>

    <p>
        @T["GalleryDescription"]
    </p>

    <div class="promotion-gallery-line"></div>

</div>


<div class="promotion-gallery-grid">

    <!-- =========================
         CARD 01
    ========================== -->
    <div class="promotion-gallery-card">

        <img src="~/images/home/coffee1.png"
             alt="@T["GalleryCard1Title"]">

        <div class="promotion-gallery-overlay">

            <span>01</span>

            <h3>
                @T["GalleryCard1Title"]
            </h3>

            <p>
                @T["GalleryCard1Description"]
            </p>

        </div>

    </div>


    <!-- =========================
