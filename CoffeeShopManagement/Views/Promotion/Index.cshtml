@model CoffeeShopManagement.ViewModels.PromotionViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShopManagement.SharedResource> T

@{
    ViewData["Title"] = T["PromotionPageTitle"];
}

<link rel="stylesheet"
      href="~/css/promotion.css"
      asp-append-version="true" />


<!-- =====================================================
     HERO
===================================================== -->

<section class="promotion-hero">

    <div class="promotion-slider">

        <!-- SLIDE 1 -->
        <div class="promotion-slide active">

            <img src="~/images/banner/banner-sale1.jpg"
                 asp-append-version="true"
                 alt="Flash Sale Rosalie Coffee" />

            <div class="promotion-overlay"></div>

            <div class="promotion-content">

                <span class="promotion-badge">
                    ⚡ @T["PromotionHeroSpecialBadge"]
                </span>

                <h2>FLASH</h2>

                <h1>SALE</h1>

                <h3>@T["PromotionHeroDiscount30"]</h3>

                <p>
                    @T["PromotionHeroSlide1Description"]
                </p>

                <a asp-controller="Menu"
                   asp-action="Products"
                   class="promotion-button">

                    @T["ExploreNow"]

                    <i class="bi bi-arrow-right-circle-fill"></i>

                </a>

            </div>

        </div>


        <!-- SLIDE 2 -->
        <div class="promotion-slide">

            <img src="~/images/banner/banner-sale2.jpg"
                 asp-append-version="true"
                 alt="Combo Rosalie Coffee" />

            <div class="promotion-overlay"></div>

            <div class="promotion-content">

                <span class="promotion-badge">
                    ☕ @T["PromotionComboBadge"]
                </span>

                <h2>ROSALIE</h2>

                <h1>COMBO</h1>

                <h3>@T["PromotionComboHeroSubtitle"]</h3>

                <p>
                    @T["PromotionComboHeroDescription"]
                </p>

                <a href="#comboSection"
                   class="promotion-button">

                    @T["ViewCombo"]

                    <i class="bi bi-arrow-right-circle-fill"></i>

                </a>

            </div>

        </div>


        <!-- SLIDE 3 -->
        <div class="promotion-slide">

            <img src="~/images/banner/banner-sale3.jpg"
                 asp-append-version="true"
                 alt="Voucher Rosalie Coffee" />

            <div class="promotion-overlay"></div>

            <div class="promotion-content">

                <span class="promotion-badge">
                    🎟 @T["PromotionVoucherBadge"]
                </span>

                <h2>@T["PromotionVoucherHeroTop"]</h2>

                <h1>VOUCHER</h1>

                <h3>@T["PromotionVoucherHeroDiscount"]</h3>

                <p>
                    @T["PromotionVoucherHeroDescription"]
                </p>

                <a href="#voucherSection"
                   class="promotion-button">

                    @T["GetVoucher"]

                    <i class="bi bi-arrow-right-circle-fill"></i>

                </a>

            </div>

        </div>


        <!-- DOTS -->
        <div class="promotion-dots">

            <span class="promotion-dot active"></span>
            <span class="promotion-dot"></span>
            <span class="promotion-dot"></span>

        </div>

    </div>

</section>


<!-- =====================================================
     FLASH SALE
===================================================== -->

<div class="promotion-flash">

    <div class="promotion-flash-left">

        <div class="promotion-flash-title">

            <i class="bi bi-lightning-charge-fill"></i>

            FLASH SALE

        </div>


        <div class="promotion-flash-time">

            <div class="promotion-flash-item">

                <span id="flashHour">02</span>

                <small>@T["Hours"]</small>

            </div>


            <div class="promotion-flash-colon">:</div>


            <div class="promotion-flash-item">

                <span id="flashMinute">59</span>

                <small>@T["Minutes"]</small>

            </div>


            <div class="promotion-flash-colon">:</div>


            <div class="promotion-flash-item">

                <span id="flashSecond">34</span>

                <small>@T["Seconds"]</small>

            </div>

        </div>

    </div>

</div>


<div class="promotion-flash-note">

    @T["FlashSaleNote"]

</div>


<!-- =====================================================
     SẢN PHẨM KHUYẾN MÃI
===================================================== -->

<section class="promotion-header">

    <div class="promotion-heading">

        <h2>
            @T["PromotionProductsHeading"]
        </h2>

        <p>
            @T["PromotionProductCountText", Model.SanPhams.Count]
        </p>

    </div>

</section>


<section class="promotion-products">

    @if (Model.SanPhams != null &&
         Model.SanPhams.Any())
    {
        <div class="promotion-grid">

            @for (int i = 0;
                  i < Model.SanPhams.Count;
                  i++)
            {
                var item =
                    Model.SanPhams[i];


                string category =
                    item.MaLoai switch
                    {
                        1 => "coffee",
                        2 => "tea",
                        3 => "matcha",
                        4 => "soda",
                        5 => "cake",
                        6 => "juice",
                        7 => "yogurt",
                        8 => "blended",
                        _ => "other"
                    };


                var sold =
                    new Random(
                        item.MaSp
                    )
                    .Next(
                        80,
                        500
                    );


                var progress =
                    new Random(
                        item.MaSp
                    )
                    .Next(
                        20,
                        95
                    );


                <div class="promotion-card @(i >= 4 ? "extra-product" : "")"
                     data-category="@category"
                     data-price="@item.GiaKhuyenMai"
                     data-discount="@item.PhanTramGiam">


                    <!-- IMAGE -->
                    <div class="promotion-image">

                        <img src="@Url.Content("~/images/menu/" + item.HinhAnh)"
                             alt="@item.TenSp" />


                        @if (item.PhanTramGiam.HasValue)
                        {
                            <span class="promotion-discount">

                                -@item.PhanTramGiam%

                            </span>
                        }


                        @if (item.PhanTramGiam >= 30)
                        {
                            <span class="promotion-hot">

                                HOT

                            </span>
                        }


                        @if (item.MaSp % 3 == 0)
                        {
                            <span class="promotion-new">

                                NEW

                            </span>
                        }

                    </div>


                    <!-- BODY -->
                    <div class="promotion-body">

                        <h4 class="promotion-name">

                            @item.TenSp

                        </h4>


                        <!-- PRICE -->
                        <div class="promotion-price">

                            <del class="promotion-old-price">

                                @item.DonGia.ToString("N0")đ

                            </del>


                            <strong class="promotion-new-price">

                                @(item.GiaKhuyenMai.HasValue
                                    ? item.GiaKhuyenMai.Value.ToString("N0") + "đ"
                                    : item.DonGia.ToString("N0") + "đ")

                            </strong>

                        </div>


                        <!-- SOLD -->
                        <div class="promotion-sold">

                            <span class="sold">

                                🔥 @T["SoldCount", sold]

                            </span>


                            <span class="stock">

                                @T["InStock"]

                            </span>

                        </div>


                        <div class="promotion-progress">

                            <div class="promotion-progress-bar"
                                 style="width:@progress%">
                            </div>

                        </div>


                        <a asp-controller="Menu"
                           asp-action="Details"
                           asp-route-id="@item.MaSp"
                           asp-route-source="promotion"
                           class="promotion-cart">

                            <i class="bi bi-eye"></i>

                            @T["ViewDetails"]

                        </a>

                    </div>

                </div>
            }

        </div>


        @if (Model.SanPhams.Count > 4)
        {
            <div class="combo-more">

                <button id="showAllProduct"
                        type="button"
                        class="combo-more-btn">

                    @T["ViewAllProducts"] ▼

                </button>

            </div>
        }
    }
    else
    {
        <div class="promotion-empty">

            @T["NoPromotionProducts"]

        </div>
    }

</section>


<!-- =====================================================
     COMBO TIẾT KIỆM
===================================================== -->

<section class="combo-section"
         id="comboSection">

    <div class="combo-header">

        <h2>
            @T["SavingComboTitle"]
        </h2>

        <p>
            @T["SavingComboDescription"]
        </p>

    </div>


    @if (Model.Combos != null &&
         Model.Combos.Any())
    {
        <div class="combo-grid">

            @for (int i = 0;
                  i < Model.Combos.Count;
                  i++)
            {
                var combo =
                    Model.Combos[i];


                <div class="combo-card @(i >= 3 ? "extra-combo" : "")">


                    <!-- DISCOUNT -->
                    <div class="combo-discount">

                        -@combo.PhanTramGiam%

                    </div>


                    <!-- IMAGE -->
                    <img src="~/images/combo/@combo.HinhAnh"
                         asp-append-version="true"
                         alt="@combo.TenCombo"
                         class="combo-image" />


                    <!-- CONTENT -->
                    <div class="combo-content">

                        <h3>
                            @combo.TenCombo
                        </h3>


                        <p>
                            @(string.IsNullOrWhiteSpace(combo.MoTa)
                                ? T["DefaultComboDescription"].Value
                                : combo.MoTa)
                        </p>


                        <!-- PRICE -->
                        <div class="combo-price">

                            <span class="combo-old-price">

                                @combo.GiaGoc.ToString("N0")đ

                            </span>


                            <span class="combo-new-price">

                                @combo.GiaBan.ToString("N0")đ

                            </span>

                        </div>


                        <!-- ACTION -->
                        <div class="combo-action">

                            <a asp-controller="Promotion"
                               asp-action="ComboDetails"
                               asp-route-id="@combo.MaCombo"
                               class="btn-view-combo">

                                <i class="bi bi-eye"></i>

                                @T["ViewCombo"]

                            </a>


                            <button type="button"
                                    class="btn-combo"
                                    data-id="@combo.MaCombo">

                                <i class="bi bi-cart-plus"></i>

                                @T["AddToCart"]

                            </button>

                        </div>

                    </div>

                </div>
            }

        </div>


        @if (Model.Combos.Count > 3)
        {
            <div class="combo-more">

                <button id="showAllCombo"
                        type="button"
                        class="combo-more-btn">

                    @T["ViewAllCombos"] ▼

                </button>

            </div>
        }
    }
    else
    {
        <div class="promotion-empty">

            @T["NoPromotionCombos"]

        </div>
    }

</section>


<!-- =====================================================
     VOUCHER
===================================================== -->

<section class="promotion-voucher"
         id="voucherSection">

    <div class="promotion-voucher-title">

        <i class="bi bi-ticket-perforated-fill"></i>

        <div>

            <h2>
                @T["VoucherForYou"]
            </h2>

            <p>
                @T["VoucherSaveDescription"]
            </p>

        </div>

    </div>


    <div class="promotion-voucher-list">


        <!-- ROSALIE15 -->
        <div class="promotion-voucher-card">

            <div class="voucher-ticket">

                <span>
                    @T["Discount"]
                </span>

                <strong>
                    15K
                </strong>

            </div>

          
            

            <div class="promotion-voucher-info">

                <div class="promotion-voucher-code">

                    ROSALIE15

                </div>


                <strong>

                    @T["VoucherDiscount15"]

                </strong>


                <span>

                    @T["ApplicableFrom"]
                    <b>99.000đ</b>

                </span>


                <small>

                    @T["ExpiryDate"]: 31/12/2026

                </small>

            </div>


            <button type="button"
                    class="promotion-voucher-button"
                    data-code="ROSALIE15"
                    data-discount="15000"
                    data-min="99000">

                @T["SaveVoucher"]

            </button>

        </div>


        <!-- ROSALIE30 -->
        <div class="promotion-voucher-card">

            <div class="voucher-ticket">

                <span>
                    @T["Discount"]
                </span>

                <strong>
                    30K
                </strong>

            </div>


            <div class="promotion-voucher-info">

                <div class="promotion-voucher-code">

                    ROSALIE30

                </div>


                <strong>

                    @T["VoucherDiscount30"]

                </strong>


                <span>

                    @T["ApplicableFrom"]
                    <b>199.000đ</b>

                </span>


                <small>

                    @T["ExpiryDate"]: 31/12/2026

                </small>

            </div>


            <button type="button"
                    class="promotion-voucher-button"
                    data-code="ROSALIE30"
                    data-discount="30000"
                    data-min="199000">

                @T["SaveVoucher"]

            </button>

        </div>


        <!-- ROSALIE50 -->
        <div class="promotion-voucher-card">

            <div class="voucher-ticket">

                <span>
                    @T["Discount"]
                </span>

                <strong>
                    50K
                </strong>

            </div>


            <div class="promotion-voucher-info">

                <div class="promotion-voucher-code">

                    ROSALIE50

                </div>


                <strong>

                    @T["VoucherDiscount50"]

                </strong>


                <span>

                    @T["ApplicableFrom"]
                    <b>299.000đ</b>

                </span>


                <small>

                    @T["ExpiryDate"]: 31/12/2026

                </small>

            </div>


            <button type="button"
                    class="promotion-voucher-button"
                    data-code="ROSALIE50"
                    data-discount="50000"
                    data-min="299000">

                @T["SaveVoucher"]

            </button>

        </div>

    </div>

</section>


<!-- =====================================================
     BACK TO TOP
===================================================== -->

<button type="button"
        class="promotion-backtop">

    <i class="bi bi-arrow-up"></i>

</button>


<!-- =====================================================
     LOADER
===================================================== -->

<div class="promotion-loader">

    <div class="promotion-spinner">
    </div>

</div>


<!-- =====================================================
     TOAST
===================================================== -->

<div class="promotion-toast"
     id="promotionToast">
</div>


