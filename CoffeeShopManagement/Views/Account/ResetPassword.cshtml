@model CoffeeShopManagement.ViewModels.ResetPasswordViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShopManagement.SharedResource> T

@{
    Layout = null;
    ViewData["Title"] = T["ResetPasswordPageTitle"];
}

<!DOCTYPE html>

<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @T["ResetPasswordPageTitle"] - Rosalie Coffee
    </title>

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

</head>

<body>

    <div class="login-page">

        <div class="login-container">


            <!-- =========================================
                 LEFT
            ========================================== -->

            <div class="login-left">

                <img src="~/images/auth/login.jpg"
                     class="login-banner"
                     alt="Rosalie Coffee" />

                <div class="overlay"></div>


                <div class="login-content">

                    <h1>
                        @T["CreateNewPasswordTitle"]
                    </h1>


                    <p>
                        @T["CreateNewPasswordDescription"]
                    </p>

                </div>

            </div>


            <!-- =========================================
                 RIGHT
            ========================================== -->

            <div class="login-right">

                <h2>
                    @T["ResetPasswordTitle"]
                </h2>


                <p class="login-desc">
                    @T["ResetPasswordDescription"]
                </p>


                <form asp-controller="Account"
                      asp-action="ResetPassword"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- =================================
                         NEW PASSWORD
                    ================================== -->

                    <div class="form-group">

                        <label asp-for="MatKhauMoi">
                            @T["NewPassword"]
                        </label>


                        <input asp-for="MatKhauMoi"
                               class="form-control"
                               placeholder="@T["NewPasswordPlaceholder"]" />


                        <span asp-validation-for="MatKhauMoi"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         CONFIRM PASSWORD
                    ================================== -->

                    <div class="form-group">

                        <label asp-for="XacNhanMatKhau">
                            @T["ConfirmNewPassword"]
                        </label>


                        <input asp-for="XacNhanMatKhau"
                               class="form-control"
                               placeholder="@T["ConfirmNewPasswordPlaceholder"]" />


                        <span asp-validation-for="XacNhanMatKhau"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         BUTTON
                    ================================== -->

                    <button type="submit"
                            class="btn-login">

                        @T["ChangePassword"]

                    </button>

                </form>

            </div>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js">
    </script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js">
    </script>

</body>

</html>