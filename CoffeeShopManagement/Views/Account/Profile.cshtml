@model CoffeeShopManagement.Models.KhachHang

@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShopManagement.SharedResource> T

@{
    ViewData["Title"] = T["ProfilePageTitle"];
}

<link rel="stylesheet"
      href="~/css/profile.css"
      asp-append-version="true" />

<section class="profile-page">

    <div class="profile-wrapper">

        <!-- =========================
             PAGE HEADING
        ========================== -->
        <div class="profile-page-heading">
            <span>TÀI KHOẢN ROSALIE</span>

            <h1>Thông tin cá nhân</h1>

            <p>
                Quản lý và cập nhật thông tin tài khoản của bạn.
            </p>
        </div>


        <div class="profile-container">

            <!-- =========================
                 LEFT SIDEBAR
            ========================== -->
            <aside class="profile-sidebar">

                <div class="profile-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="profile-user-info">

                    <h2>@Model.HoTen</h2>

                    <p>@Model.Email</p>

                </div>


                <div class="profile-divider"></div>


                <div class="profile-meta">

                    <div class="profile-meta-icon">
                        <i class="bi bi-calendar3"></i>
                    </div>

                    <div>
                        <span>Ngày tạo tài khoản</span>

                        <strong>
                            @Model.NgayTao.ToString("dd/MM/yyyy")
                        </strong>
                    </div>

                </div>


                <a asp-controller="Account"
                   asp-action="OrderHistory"
                   class="profile-order-link">

                    <i class="bi bi-bag-check"></i>

                    <span>Đơn hàng của tôi</span>

                    <i class="bi bi-chevron-right profile-order-arrow"></i>

                </a>

            </aside>


            <!-- =========================
                 RIGHT CONTENT
            ========================== -->
            <main class="profile-content">

                <div class="profile-section-heading">

                    <div class="profile-heading-icon">
                        <i class="bi bi-person-gear"></i>
                    </div>

                    <div>
                        <h2>Thông tin tài khoản</h2>

                        <p>
                            Bạn có thể thay đổi họ tên, số điện thoại
                            và địa chỉ tại đây.
                        </p>
                    </div>

                </div>


                <form asp-controller="Account"
                      asp-action="Profile"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>


                    <!-- NAME -->
                    <div class="profile-form-group">

                        <label asp-for="HoTen">
                            Họ và tên
                        </label>

                        <div class="profile-input">

                            <i class="bi bi-person"></i>

                            <input asp-for="HoTen"
                                   placeholder="Nhập họ và tên" />

                        </div>

                        <span asp-validation-for="HoTen"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMAIL -->
                    <div class="profile-form-group">

                        <label>Email</label>

                        <div class="profile-input disabled">

                            <i class="bi bi-envelope"></i>

                            <input value="@Model.Email"
                                   readonly />

                            <span class="profile-locked">
                                <i class="bi bi-lock-fill"></i>
                            </span>

                        </div>

                        <small>
                            Email đăng nhập không thể thay đổi.
                        </small>

                    </div>


                    <!-- PHONE -->
                    <div class="profile-form-group">

                        <label asp-for="DienThoai">
                            Số điện thoại
                        </label>

                        <div class="profile-input">

                            <i class="bi bi-telephone"></i>

                            <input asp-for="DienThoai"
                                   placeholder="Nhập số điện thoại" />

                        </div>

                        <span asp-validation-for="DienThoai"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ADDRESS -->
                    <div class="profile-form-group">

                        <label asp-for="DiaChi">
                            Địa chỉ
                        </label>

                        <div class="profile-input profile-textarea">

                            <i class="bi bi-geo-alt"></i>

                            <textarea asp-for="DiaChi"
                                      rows="3"
                                      placeholder="Nhập địa chỉ của bạn"></textarea>

                        </div>

                    </div>


                    <!-- CREATED DATE -->
                    <div class="profile-form-group">

                        <label>Ngày tạo tài khoản</label>

                        <div class="profile-input disabled">

                            <i class="bi bi-calendar3"></i>

                            <input value="@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")"
                                   readonly />

                        </div>

                    </div>


                    <!-- ACTION -->
                    <div class="profile-actions">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="profile-back">

                            <i class="bi bi-arrow-left"></i>
                            Quay lại

                        </a>

                        <button type="submit"
                                class="profile-save">

                            <i class="bi bi-check-lg"></i>
                            Lưu thay đổi

                        </button>

                    </div>

                </form>

            </main>

        </div>

    </div>

</section>


@if (TempData["Success"] != null)
{
    <div id="profileToast"
         class="profile-toast">

        <div class="profile-toast-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <div class="profile-toast-text">
            <strong>Thành công</strong>
            <span>@TempData["Success"]</span>
        </div>

        <button type="button"
                class="profile-toast-close"
                onclick="closeProfileToast()">

            <i class="bi bi-x-lg"></i>

        </button>

    </div>
}


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const toast = document.getElementById("profileToast");

            if (toast) {

                setTimeout(function () {
                    closeProfileToast();
                }, 2000);

            }

        });


        function closeProfileToast() {

            const toast = document.getElementById("profileToast");

            if (!toast) return;

            toast.classList.add("hide");

            setTimeout(function () {
                toast.remove();
            }, 300);
        }
    </script>
}