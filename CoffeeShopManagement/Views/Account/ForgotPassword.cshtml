@model CoffeeShopManagement.ViewModels.ForgotPasswordViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShopManagement.SharedResource> T

@{
    Layout = null;
    ViewData["Title"] = T["ForgotPasswordPageTitle"];
}

<!DOCTYPE html>

<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @T["ForgotPasswordPageTitle"] - Rosalie Coffee
    </title>


    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

</head>


<body>

    <div class="login-page">

        <div class="login-container">


            <!-- =========================================
                 LEFT
            ========================================== -->

            <div class="login-left">

                <img src="~/images/auth/login.jpg"
                     class="login-banner"
                     alt="Rosalie Coffee" />


                <div class="overlay"></div>


                <div class="login-content">

                    <h1>
                        @T["RecoverPasswordTitle"]
                    </h1>


                    <p>
                        @T["RecoverPasswordDescription"]
                    </p>


                    <a asp-controller="Account"
                       asp-action="Login"
                       class="back-home">

                        <i class="fa-solid fa-arrow-left"></i>

                        @T["BackToLogin"]

                    </a>

                </div>

            </div>


            <!-- =========================================
                 RIGHT
            ========================================== -->

            <div class="login-right">

                <h2>
                    @T["ForgotPasswordQuestion"]
                </h2>


                <p class="login-desc">

                    @T["ForgotPasswordDescription"]

                </p>


                <!-- =====================================
                     FORM
                ====================================== -->

                <form asp-controller="Account"
                      asp-action="ForgotPassword"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- =================================
                         EMAIL
                    ================================== -->

                    <div class="form-group">

                        <label asp-for="Email">

                            @T["Email"]

                        </label>


                        <input asp-for="Email"
                               class="form-control"
                               placeholder="@T["EmailPlaceholder"]" />


                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         BUTTON
                    ================================== -->

                    <button type="submit"
                            class="btn-login">

                        @T["SendOtp"]

                    </button>

                </form>


                <!-- =====================================
                     LOGIN LINK
                ====================================== -->

                <div class="register-text">

                    @T["RememberPassword"]

                    <a asp-controller="Account"
                       asp-action="Login">

                        @T["LoginNow"]

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         VALIDATION SCRIPTS
    ========================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js">
    </script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js">
    </script>

</body>

</html>