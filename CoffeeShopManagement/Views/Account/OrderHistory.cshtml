@model List<CoffeeShopManagement.Models.HoaDon>

@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShopManagement.SharedResource> T

@{
    ViewData["Title"] = T["OrderHistoryPageTitle"];

    var reviewedKeys =
        ViewBag.ReviewedKeys as List<string>
        ?? new List<string>();


    var reviewedComboKeys =
        ViewBag.ReviewedComboKeys as List<string>
        ?? new List<string>();


    var orders =
        Model ?? new List<CoffeeShopManagement.Models.HoaDon>();

    int totalOrders = orders.Count;

    int pendingOrders = orders.Count(x =>
        (x.TrangThai ?? "").Trim() == "Chờ xác nhận");

    int processingOrders = orders.Count(x =>
        (x.TrangThai ?? "").Trim() == "Đang xử lý");

    int shippingOrders = orders.Count(x =>
        (x.TrangThai ?? "").Trim() == "Đang giao hàng");

    int completedOrders = orders.Count(x =>
        (x.TrangThai ?? "").Trim() == "Hoàn thành");

    int cancelledOrders = orders.Count(x =>
        (x.TrangThai ?? "").Trim() == "Đã hủy"
        || (x.TrangThai ?? "").Trim() == "Đã hủy - Chờ hoàn tiền"
        || (x.TrangThai ?? "").Trim() == "Đã hủy - Đã hoàn tiền");
}

<link rel="stylesheet"
      href="~/css/order-history.css"
      asp-append-version="true" />

<section class="order-history-page">

    <div class="order-history-container">

        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->
        <header class="order-history-header">

            <div class="history-heading-copy">

                <span class="history-eyebrow">
                    ROSALIE COFFEE
                </span>

                <h1>
                    @T["MyOrders"]
                </h1>

                <p>
                    Theo dõi, tìm kiếm và quản lý các đơn hàng bạn đã đặt tại Rosalie Coffee.
                </p>

            </div>

            <a asp-controller="Account"
               asp-action="Profile"
               class="history-back">

                <i class="bi bi-arrow-left"></i>
                @T["PersonalInformation"]

            </a>

        </header>


        @if (!orders.Any())
        {
            <div class="history-empty">

                <div class="history-empty-icon">
                    <i class="bi bi-bag"></i>
                </div>

                <h2>@T["NoOrdersTitle"]</h2>

                <p>@T["NoOrdersDescription"]</p>

                <a asp-controller="Menu"
                   asp-action="Products"
                   class="history-shop-btn">

                    @T["ExploreMenu"]

                </a>

            </div>
        }
        else
        {
            <!-- =====================================================
                 FILTER TOOLBAR
            ====================================================== -->
            <div class="history-toolbar">

                <div class="history-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="orderSearchInput"
                           placeholder="Tìm theo mã đơn hàng..." />

                </div>

                <div class="history-filter">

                    <select id="orderStatusFilter"
                            aria-label="Lọc trạng thái">

                        <option value="all">
                            Tất cả trạng thái
                        </option>

                        <option value="Chờ xác nhận">
                            Chờ xác nhận
                        </option>

                        <option value="Đã thanh toán">
                            Đã thanh toán
                        </option>

                        <option value="Đang xử lý">
                            Đang xử lý
                        </option>

                        <option value="Đang giao hàng">
                            Đang giao hàng
                        </option>

                        <option value="Hoàn thành">
                            Hoàn thành
                        </option>

                        <option value="Đã hủy">
                            Đã hủy
                        </option>

                        <option value="Yêu cầu hủy">
                            Yêu cầu hủy
                        </option>

                    </select>

                    <i class="bi bi-chevron-down"></i>

                </div>

                <div class="history-filter">

                    <select id="orderTimeFilter"
                            aria-label="Lọc thời gian">

                        <option value="all">
                            Tất cả thời gian
                        </option>

                        <option value="7">
                            7 ngày gần đây
                        </option>

                        <option value="30">
                            30 ngày gần đây
                        </option>

                        <option value="90">
                            3 tháng gần đây
                        </option>

                        <option value="365">
                            1 năm gần đây
                        </option>

                    </select>

                    <i class="bi bi-chevron-down"></i>

                </div>

                <button type="button"
                        id="orderFilterReset"
                        class="history-reset-btn">

                    <i class="bi bi-arrow-counterclockwise"></i>
                    Đặt lại

                </button>

            </div>


            <!-- =====================================================
                 CONTENT GRID
            ====================================================== -->
            <div class="history-layout">

                <!-- =============================================
                     ORDER COLUMN
                ============================================== -->
                <div class="history-main">

                    <div class="history-results-bar">

                        <div>

                            <strong id="historyResultCount">
                                @totalOrders
                            </strong>

                            <span>đơn hàng</span>

                        </div>

                        <span id="historyFilterHint">
                            Hiển thị tất cả đơn hàng
                        </span>

                    </div>


                    <div class="history-list"
                         id="historyOrderList">

                        @foreach (var order in orders)
                        {
                            var currentStatus =
                                order.TrangThai?.Trim() ?? "";

                            string statusClass =
                                currentStatus == "Hoàn thành"
                                    ? "completed"
                                    : currentStatus == "Đã thanh toán"
                                        ? "paid"
                                        : currentStatus == "Đang xử lý"
                                            ? "processing"
                                            : currentStatus == "Đang giao hàng"
                                                ? "shipping"
                                                : currentStatus == "Thanh toán thất bại"
                                                    ? "failed"
                                                    : currentStatus == "Đã hủy"
                                                      || currentStatus == "Đã hủy - Chờ hoàn tiền"
                                                      || currentStatus == "Đã hủy - Đã hoàn tiền"
                                                        ? "cancelled"
                                                        : currentStatus == "Yêu cầu hủy"
                                                          || currentStatus == "Yêu cầu hủy khi đang giao"
                                                            ? "cancel-request"
                                                            : "pending";

                            string statusText =
                                currentStatus == "Đã thanh toán"
                                    ? T["OrderStatusPaid"].Value
                                    : currentStatus == "Thanh toán thất bại"
                                        ? T["OrderStatusFailed"].Value
                                        : string.IsNullOrWhiteSpace(currentStatus)
                                            ? T["OrderStatusPending"].Value
                                            : currentStatus;

                            bool canReview =
                                currentStatus == "Hoàn thành";

                            bool canCancelDirectly =
                                currentStatus == "Chờ xác nhận";

                            bool canRequestCancel =
                                currentStatus == "Đã thanh toán"
                                || currentStatus == "Đang xử lý";

                            bool canRequestCancelShipping =
                                currentStatus == "Đang giao hàng";

                            bool showCancelButton =
                                canCancelDirectly
                                || canRequestCancel
                                || canRequestCancelShipping;

                            string cancelButtonText =
                                canCancelDirectly
                                    ? "Hủy đơn"
                                    : canRequestCancelShipping
                                        ? "Yêu cầu hủy khi đang giao"
                                        : "Yêu cầu hủy";

                            string cancelButtonIcon =
                                canCancelDirectly
                                    ? "bi-x-circle"
                                    : canRequestCancelShipping
                                        ? "bi-truck"
                                        : "bi-exclamation-circle";

                            string orderCode =
                                $"#HD{order.MaHd:D5}";

                            string orderDateIso =
                                order.NgayDat.HasValue
                                    ? order.NgayDat.Value.ToString("yyyy-MM-ddTHH:mm:ss")
                                    : "";

                            <article class="history-card"
                                     data-order-code="@orderCode.ToLower()"
                                     data-order-status="@currentStatus"
                                     data-order-date="@orderDateIso">

                                <!-- =====================================
                                     CARD HEADER
                                ====================================== -->
                                <div class="history-card-top">

                                    <div class="history-order-main">

                                        <div class="history-order-icon">
                                            <i class="bi bi-receipt"></i>
                                        </div>

                                        <div>

                                            <span class="history-label">
                                                @T["OrderCode"]
                                            </span>

                                            <strong class="history-order-code">
                                                @orderCode
                                            </strong>

                                        </div>

                                    </div>


                                    <div class="history-info">

                                        <span>
                                            @T["OrderDate"]
                                        </span>

                                        <strong>
                                            @order.NgayDat?.ToString("dd/MM/yyyy HH:mm")
                                        </strong>

                                    </div>


                                    <div class="history-info">

                                        <span>
                                            @T["PaymentTotal"]
                                        </span>

                                        <strong class="history-price">
                                            @((order.TongTien ?? 0).ToString("N0"))đ
                                        </strong>

                                    </div>


                                    <div class="history-info">

                                        <span>
                                            @T["OrderStatus"]
                                        </span>

                                        <strong class="history-status @statusClass">
                                            @statusText
                                        </strong>

                                    </div>


                                    <div class="history-action">

                                        <a asp-controller="Checkout"
                                           asp-action="Success"
                                           asp-route-id="@order.MaHd"
                                           class="history-detail-btn">

                                            @T["ViewDetails"]

                                            <i class="bi bi-arrow-right"></i>

                                        </a>

                                    </div>

                                </div>


                                <!-- =====================================
                                     CANCEL INFORMATION
                                ====================================== -->
                                @if (
                                    !string.IsNullOrWhiteSpace(order.LyDoHuy)
                                    || order.NgayYeuCauHuy.HasValue
                                    || !string.IsNullOrWhiteSpace(order.TrangThaiHoanTien)
                                )
                                {
                                    <div class="history-cancel-info">

                                        <div class="history-cancel-info-icon">
                                            <i class="bi bi-info-circle"></i>
                                        </div>

                                        <div class="history-cancel-info-content">

                                            <strong>
                                                Thông tin hủy đơn
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(order.LyDoHuy))
                                            {
                                                <p>
                                                    <span>Lý do:</span>
                                                    @order.LyDoHuy
                                                </p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(order.GhiChuHuy))
                                            {
                                                <p>
                                                    <span>Ghi chú:</span>
                                                    @order.GhiChuHuy
                                                </p>
                                            }

                                            @if (order.NgayYeuCauHuy.HasValue)
                                            {
                                                <p>
                                                    <span>Thời gian yêu cầu:</span>
                                                    @order.NgayYeuCauHuy.Value.ToString("dd/MM/yyyy HH:mm")
                                                </p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(order.TrangThaiHoanTien))
                                            {
                                                <p>
                                                    <span>Hoàn tiền:</span>

                                                    <strong class="history-refund-status">
                                                        @order.TrangThaiHoanTien
                                                    </strong>
                                                </p>
                                            }

                                            @if (order.SoTienHoan.HasValue && order.SoTienHoan.Value > 0)
                                            {
                                                <p>
                                                    <span>Số tiền hoàn:</span>

                                                    <strong class="history-refund-money">
                                                        @order.SoTienHoan.Value.ToString("N0")đ
                                                    </strong>
                                                </p>
                                            }

                                        </div>

                                    </div>
                                }


                                <!-- =====================================
                                     PRODUCTS
                                ====================================== -->
                                @if (
                                    order.ChiTietHoaDons != null
                                    && order.ChiTietHoaDons.Any()
                                )
                                {
                                    <div class="history-products">

                                        @foreach (var item in order.ChiTietHoaDons)
                                        {
                                            if (
                                                item.MaSp.HasValue
                                                && item.MaSpNavigation != null
                                            )
                                            {
                                                var product =
                                                    item.MaSpNavigation;

                                                string reviewKey =
                                                    $"{order.MaHd}_{product.MaSp}";

                                                bool reviewed =
                                                    reviewedKeys.Contains(reviewKey);

                                                <div class="history-product-item">

                                                    <a asp-controller="Menu"
                                                       asp-action="Details"
                                                       asp-route-id="@product.MaSp"
                                                       class="history-product-image">

                                                        <img src="~/images/menu/@product.HinhAnh"
                                                             asp-append-version="true"
                                                             alt="@product.TenSp" />

                                                    </a>


                                                    <div class="history-product-info">

                                                        <span class="history-product-label">
                                                            SẢN PHẨM
                                                        </span>

                                                        <a asp-controller="Menu"
                                                           asp-action="Details"
                                                           asp-route-id="@product.MaSp"
                                                           class="history-product-name">

                                                            @product.TenSp

                                                        </a>

                                                        <div class="history-product-meta">

                                                            <span>
                                                                Số lượng:
                                                                <strong>@item.SoLuong</strong>
                                                            </span>

                                                            <span>
                                                                Đơn giá:
                                                                <strong>@item.DonGia.ToString("N0")đ</strong>
                                                            </span>

                                                        </div>

                                                    </div>


                                                    <div class="history-product-review">

                                                        @if (reviewed)
                                                        {
                                                            <span class="history-reviewed">

                                                                <i class="bi bi-check-circle-fill"></i>
                                                                Đã đánh giá

                                                            </span>
                                                        }
                                                        else if (canReview)
                                                        {
                                                            <a asp-controller="Review"
                                                               asp-action="Create"
                                                               asp-route-maHd="@order.MaHd"
                                                               asp-route-maSp="@product.MaSp"
                                                               class="history-review-btn">

                                                                <i class="bi bi-star-fill"></i>
                                                                Đánh giá

                                                            </a>
                                                        }
                                                        else if (
                                                            currentStatus == "Đã hủy"
                                                            || currentStatus == "Đã hủy - Chờ hoàn tiền"
                                                            || currentStatus == "Đã hủy - Đã hoàn tiền"
                                                        )
                                                        {
                                                            <span class="history-review-disabled">

                                                                <i class="bi bi-x-circle"></i>
                                                                Đơn đã hủy

                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="history-review-disabled">

                                                                <i class="bi bi-clock"></i>
                                                                Chưa thể đánh giá

                                                            </span>
                                                        }

                                                    </div>

                                                </div>
                                            }

                                            if (
                                                item.MaCombo.HasValue
                                                && item.MaComboNavigation != null
                                            )
                                            {
                                                var combo =
                                                    item.MaComboNavigation;


                                                string comboReviewKey =
                                                    $"{order.MaHd}_{combo.MaCombo}";


                                                bool comboReviewed =
                                                    reviewedComboKeys.Contains(
                                                        comboReviewKey
                                                    );


                                                <div class="history-product-item">

                                                    <a asp-controller="Promotion"
                                                       asp-action="ComboDetails"
                                                       asp-route-id="@combo.MaCombo"
                                                       class="history-product-image">

                                                        <img src="~/images/combo/@combo.HinhAnh"
                                                             asp-append-version="true"
                                                             alt="@combo.TenCombo" />

                                                    </a>


                                                    <div class="history-product-info">

                                                        <span class="history-product-label combo">
                                                            COMBO
                                                        </span>


                                                        <a asp-controller="Promotion"
                                                           asp-action="ComboDetails"
                                                           asp-route-id="@combo.MaCombo"
                                                           class="history-product-name">

                                                            @combo.TenCombo

                                                        </a>


                                                        <div class="history-product-meta">

                                                            <span>
                                                                Số lượng:
                                                                <strong>@item.SoLuong</strong>
                                                            </span>

                                                            <span>
                                                                Đơn giá:
                                                                <strong>@item.DonGia.ToString("N0")đ</strong>
                                                            </span>

                                                        </div>

                                                    </div>


                                                    <div class="history-product-review">

                                                        @if (comboReviewed)
                                                        {
                                                            <span class="history-reviewed">

                                                                <i class="bi bi-check-circle-fill"></i>
                                                                Đã đánh giá

                                                            </span>
                                                        }
                                                        else if (canReview)
                                                        {
                                                            <a asp-controller="Review"
                                                               asp-action="CreateCombo"
                                                               asp-route-maHd="@order.MaHd"
                                                               asp-route-maCombo="@combo.MaCombo"
                                                               class="history-review-btn">

                                                                <i class="bi bi-star-fill"></i>
                                                                Đánh giá combo

                                                            </a>
                                                        }
                                                        else if (
                                                            currentStatus == "Đã hủy"
                                                            || currentStatus == "Đã hủy - Chờ hoàn tiền"
                                                            || currentStatus == "Đã hủy - Đã hoàn tiền"
                                                        )
                                                        {
                                                            <span class="history-review-disabled">

                                                                <i class="bi bi-x-circle"></i>
                                                                Đơn đã hủy

                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="history-review-disabled">

                                                                <i class="bi bi-clock"></i>
                                                                Chưa thể đánh giá

                                                            </span>
                                                        }

                                                    </div>

                                                </div>
                                            }
                                        }

                                    </div>
                                }


                                <!-- =====================================
                                     CANCEL ACTION
                                ====================================== -->
                                @if (showCancelButton)
                                {
                                    <div class="history-order-actions">

                                        <button type="button"
                                                class="history-cancel-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#cancelOrderModal"
                                                data-order-id="@order.MaHd"
                                                data-order-code="@orderCode"
                                                data-order-status="@currentStatus"
                                                data-cancel-title="@cancelButtonText">

                                            <i class="bi @cancelButtonIcon"></i>
                                            @cancelButtonText

                                        </button>

                                    </div>
                                }

                            </article>
                        }

                    </div>


                    <!-- =============================================
                         NO FILTER RESULTS
                    ============================================== -->
                    <div class="history-no-results"
                         id="historyNoResults"
                         hidden>

                        <div class="history-no-results-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <h3>Không tìm thấy đơn hàng</h3>

                        <p>
                            Hãy thử đổi mã đơn, trạng thái hoặc khoảng thời gian.
                        </p>

                    </div>


                    <!-- =============================================
                         PAGINATION
                    ============================================== -->
                    <nav class="history-pagination"
                         id="historyPagination"
                         aria-label="Phân trang đơn hàng">
                    </nav>

                </div>


                <!-- =============================================
                     SIDEBAR
                ============================================== -->
                <aside class="history-sidebar">

                    <div class="history-side-card">

                        <h3>Tổng quan đơn hàng</h3>

                        <div class="history-summary-total">

                            <span>Tổng đơn hàng</span>
                            <strong>@totalOrders</strong>

                        </div>

                        <div class="history-summary-list">

                            <div class="history-summary-row">
                                <span>
                                    <i class="summary-dot pending"></i>
                                    Chờ xác nhận
                                </span>
                                <strong>@pendingOrders</strong>
                            </div>

                            <div class="history-summary-row">
                                <span>
                                    <i class="summary-dot processing"></i>
                                    Đang xử lý
                                </span>
                                <strong>@processingOrders</strong>
                            </div>

                            <div class="history-summary-row">
                                <span>
                                    <i class="summary-dot shipping"></i>
                                    Đang giao
                                </span>
                                <strong>@shippingOrders</strong>
                            </div>

                            <div class="history-summary-row">
                                <span>
                                    <i class="summary-dot completed"></i>
                                    Hoàn thành
                                </span>
                                <strong>@completedOrders</strong>
                            </div>

                            <div class="history-summary-row">
                                <span>
                                    <i class="summary-dot cancelled"></i>
                                    Đã hủy
                                </span>
                                <strong>@cancelledOrders</strong>
                            </div>

                        </div>

                    </div>


                    <div class="history-side-card history-support-card">

                        <div class="history-support-icon">
                            <i class="bi bi-headset"></i>
                        </div>

                        <h3>Cần hỗ trợ đơn hàng?</h3>

                        <p>
                            Nếu đơn hàng có vấn đề, bạn có thể liên hệ Rosalie Coffee để được hỗ trợ.
                        </p>

                        <a asp-controller="Contact"
                           asp-action="Index"
                           class="history-support-btn">

                            <i class="bi bi-chat-dots"></i>
                            Liên hệ ngay

                        </a>

                    </div>

                </aside>

            </div>
        }

    </div>

</section>

<!-- =========================================================
     CANCEL ORDER MODAL
========================================================= -->

<div class="modal fade"
     id="cancelOrderModal"
     tabindex="-1"
     aria-labelledby="cancelOrderModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content cancel-order-modal">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="modal-header cancel-order-modal-header">

                <div>

                    <span class="cancel-order-label">
                        ROSALIE COFFEE
                    </span>

                    <h5 class="modal-title"
                        id="cancelOrderModalLabel">

                        Hủy đơn hàng

                    </h5>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- =================================================
                 FORM
            ================================================== -->

            <form asp-controller="Account"
                  asp-action="CancelOrder"
                  method="post"
                  id="cancelOrderForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="maHd"
                       id="cancelOrderId" />


                <div class="modal-body cancel-order-modal-body">


                    <!-- ORDER -->

                    <div class="cancel-order-summary">

                        <div class="cancel-order-summary-icon">

                            <i class="bi bi-receipt"></i>

                        </div>


                        <div>

                            <span>
                                Đơn hàng
                            </span>

                            <strong id="cancelOrderCode">
                                #HD00000
                            </strong>

                        </div>

                    </div>


                    <!-- NOTICE -->

                    <div class="cancel-order-notice"
                         id="cancelOrderNotice">

                        <i class="bi bi-info-circle-fill"></i>

                        <span>
                            Vui lòng chọn lý do hủy đơn.
                        </span>

                    </div>


                    <!-- =================================================
                         REASON
                    ================================================== -->

                    <div class="cancel-order-field">

                        <label for="cancelReason">

                            Lý do hủy đơn

                            <span class="required">
                                *
                            </span>

                        </label>


                        <select id="cancelReason"
                                name="lyDoHuy"
                                required>

                            <option value="">
                                -- Chọn lý do --
                            </option>

                            <option value="Đổi ý, không muốn mua nữa">
                                Đổi ý, không muốn mua nữa
                            </option>

                            <option value="Đặt nhầm sản phẩm">
                                Đặt nhầm sản phẩm
                            </option>

                            <option value="Muốn thay đổi sản phẩm / số lượng">
                                Muốn thay đổi sản phẩm / số lượng
                            </option>

                            <option value="Địa chỉ giao hàng không đúng">
                                Địa chỉ giao hàng không đúng
                            </option>

                            <option value="Không thể nhận hàng lúc này">
                                Không thể nhận hàng lúc này
                            </option>

                            <option value="Thời gian giao hàng quá lâu">
                                Thời gian giao hàng quá lâu
                            </option>

                            <option value="Thanh toán gặp vấn đề">
                                Thanh toán gặp vấn đề
                            </option>

                            <option value="Khác">
                                Khác
                            </option>

                        </select>

                    </div>


                    <!-- =================================================
                         OTHER REASON
                    ================================================== -->

                    <div class="cancel-order-field cancel-other-field"
                         id="cancelOtherField">

                        <label for="cancelNote">

                            Lý do khác

                        </label>


                        <textarea id="cancelNote"
                                  name="ghiChuHuy"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Nhập lý do bạn muốn hủy đơn..."></textarea>


                        <div class="cancel-note-count">

                            <span id="cancelNoteCount">
                                0
                            </span>

                            / 1000

                        </div>

                    </div>


                    <!-- VALIDATE MESSAGE -->

                    <div class="cancel-order-error"
                         id="cancelOrderError">
                    </div>


                </div>


                <!-- =================================================
                     FOOTER
                ================================================== -->

                <div class="modal-footer cancel-order-modal-footer">

                    <button type="button"
                            class="cancel-order-back-btn"
                            data-bs-dismiss="modal">

                        Không

                    </button>


                    <button type="submit"
                            class="cancel-order-confirm-btn">

                        <i class="bi bi-x-circle"></i>

                        <span id="cancelSubmitText">
                            Xác nhận hủy
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // =============================================
                // ELEMENTS
                // =============================================

                const modalElement =
                    document.getElementById(
                        "cancelOrderModal"
                    );


                const orderIdInput =
                    document.getElementById(
                        "cancelOrderId"
                    );


                const orderCode =
                    document.getElementById(
                        "cancelOrderCode"
                    );


                const modalTitle =
                    document.getElementById(
                        "cancelOrderModalLabel"
                    );


                const notice =
                    document.getElementById(
                        "cancelOrderNotice"
                    );


                const reason =
                    document.getElementById(
                        "cancelReason"
                    );


                const otherField =
                    document.getElementById(
                        "cancelOtherField"
                    );


                const note =
                    document.getElementById(
                        "cancelNote"
                    );


                const noteCount =
                    document.getElementById(
                        "cancelNoteCount"
                    );


                const error =
                    document.getElementById(
                        "cancelOrderError"
                    );


                const form =
                    document.getElementById(
                        "cancelOrderForm"
                    );


                const submitText =
                    document.getElementById(
                        "cancelSubmitText"
                    );


                // =============================================
                // OPEN MODAL
                // =============================================

                modalElement?.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;


                        if (!button) {
                            return;
                        }


                        const orderId =
                            button.getAttribute(
                                "data-order-id"
                            );


                        const code =
                            button.getAttribute(
                                "data-order-code"
                            );


                        const status =
                            button.getAttribute(
                                "data-order-status"
                            );


                        const cancelTitle =
                            button.getAttribute(
                                "data-cancel-title"
                            );


                        orderIdInput.value =
                            orderId ?? "";


                        orderCode.textContent =
                            code ?? "";


                        modalTitle.textContent =
                            cancelTitle
                            ?? "Hủy đơn hàng";


                        submitText.textContent =
                            cancelTitle == "Hủy đơn"
                                ? "Xác nhận hủy"
                                : "Gửi yêu cầu";


                        // RESET

                        reason.value =
                            "";

                        note.value =
                            "";

                        noteCount.textContent =
                            "0";

                        error.textContent =
                            "";

                        otherField.style.display =
                            "none";


                        // =====================================
                        // NOTICE THEO TRẠNG THÁI
                        // =====================================

                        const noticeText =
                            notice.querySelector(
                                "span"
                            );


                        if (
                            status === "Đã thanh toán"
                        ) {

                            notice.classList.add(
                                "refund"
                            );


                            noticeText.textContent =
                                "Đơn hàng này đã được thanh toán. Sau khi yêu cầu hủy được duyệt, cửa hàng sẽ xử lý hoàn tiền cho bạn.";
                        }

                        else if (
                            status === "Đang giao hàng"
                        ) {

                            notice.classList.remove(
                                "refund"
                            );


                            noticeText.textContent =
                                "Đơn đang được giao. Cửa hàng cần kiểm tra với nhân viên giao hàng trước khi xác nhận hủy.";
                        }

                        else if (
                            status === "Đang xử lý"
                        ) {

                            notice.classList.remove(
                                "refund"
                            );


                            noticeText.textContent =
                                "Đơn đang được xử lý. Yêu cầu hủy của bạn cần được cửa hàng xác nhận.";
                        }

                        else {

                            notice.classList.remove(
                                "refund"
                            );


                            noticeText.textContent =
                                "Đơn chưa được xử lý nên bạn có thể hủy ngay.";
                        }

                    }
                );


                // =============================================
                // OTHER
                // =============================================

                reason?.addEventListener(
                    "change",
                    function () {

                        if (
                            this.value === "Khác"
                        ) {

                            otherField.style.display =
                                "block";

                            note.focus();
                        }
                        else {

                            otherField.style.display =
                                "none";

                            note.value =
                                "";

                            noteCount.textContent =
                                "0";
                        }


                        error.textContent =
                            "";

                    }
                );


                // =============================================
                // COUNT
                // =============================================

                note?.addEventListener(
                    "input",
                    function () {

                        noteCount.textContent =
                            this.value.length;

                    }
                );


                // =============================================
                // VALIDATE
                // =============================================

                form?.addEventListener(
                    "submit",
                    function (event) {

                        error.textContent =
                            "";


                        if (
                            !reason.value
                        ) {

                            event.preventDefault();

                            error.textContent =
                                "Vui lòng chọn lý do hủy đơn.";

                            return;
                        }


                        if (
                            reason.value === "Khác"
                            &&
                            !note.value.trim()
                        ) {

                            event.preventDefault();

                            error.textContent =
                                "Vui lòng nhập lý do hủy đơn.";

                            note.focus();

                            return;
                        }

                    }
                );



                // =============================================
                // ORDER SEARCH + FILTER + PAGINATION
                // =============================================

                const searchInput =
                    document.getElementById("orderSearchInput");

                const statusFilter =
                    document.getElementById("orderStatusFilter");

                const timeFilter =
                    document.getElementById("orderTimeFilter");

                const resetFilter =
                    document.getElementById("orderFilterReset");

                const orderCards =
                    Array.from(
                        document.querySelectorAll(
                            "#historyOrderList .history-card"
                        )
                    );

                const pagination =
                    document.getElementById("historyPagination");

                const noResults =
                    document.getElementById("historyNoResults");

                const resultCount =
                    document.getElementById("historyResultCount");

                const filterHint =
                    document.getElementById("historyFilterHint");

                const PAGE_SIZE = 4;

                let currentPage = 1;


                function getFilteredOrders() {

                    const keyword =
                        (searchInput?.value ?? "")
                            .trim()
                            .toLowerCase();

                    const selectedStatus =
                        statusFilter?.value ?? "all";

                    const selectedDays =
                        timeFilter?.value ?? "all";

                    const now =
                        new Date();


                    return orderCards.filter(function (card) {

                        const code =
                            card.dataset.orderCode ?? "";

                        const status =
                            card.dataset.orderStatus ?? "";

                        const dateValue =
                            card.dataset.orderDate ?? "";


                        const matchKeyword =
                            !keyword
                            || code.includes(keyword);


                        let matchStatus =
                            true;

                        if (selectedStatus !== "all") {

                            if (selectedStatus === "Đã hủy") {

                                matchStatus =
                                    status.startsWith("Đã hủy");
                            }

                            else if (selectedStatus === "Yêu cầu hủy") {

                                matchStatus =
                                    status.startsWith("Yêu cầu hủy");
                            }

                            else {

                                matchStatus =
                                    status === selectedStatus;
                            }
                        }


                        let matchTime =
                            true;

                        if (
                            selectedDays !== "all"
                            && dateValue
                        ) {

                            const orderDate =
                                new Date(dateValue);

                            const diffMs =
                                now.getTime()
                                - orderDate.getTime();

                            const diffDays =
                                diffMs / 86400000;

                            matchTime =
                                diffDays >= 0
                                && diffDays <= Number(selectedDays);
                        }


                        return (
                            matchKeyword
                            && matchStatus
                            && matchTime
                        );

                    });
                }


                function renderPagination(
                    totalPages
                ) {

                    if (!pagination) {
                        return;
                    }


                    pagination.innerHTML =
                        "";


                    if (totalPages <= 1) {
                        return;
                    }


                    const previous =
                        document.createElement("button");

                    previous.type =
                        "button";

                    previous.className =
                        "history-page-btn";

                    previous.innerHTML =
                        '<i class="bi bi-chevron-left"></i>';

                    previous.disabled =
                        currentPage === 1;

                    previous.addEventListener(
                        "click",
                        function () {

                            if (currentPage > 1) {

                                currentPage--;

                                renderOrders();

                                document
                                    .querySelector(".history-toolbar")
                                    ?.scrollIntoView({
                                        behavior: "smooth",
                                        block: "start"
                                    });
                            }
                        }
                    );

                    pagination.appendChild(
                        previous
                    );


                    const maxVisible =
                        5;

                    let start =
                        Math.max(
                            1,
                            currentPage
                            - Math.floor(maxVisible / 2)
                        );

                    let end =
                        Math.min(
                            totalPages,
                            start + maxVisible - 1
                        );


                    if (
                        end - start + 1
                        < maxVisible
                    ) {

                        start =
                            Math.max(
                                1,
                                end - maxVisible + 1
                            );
                    }


                    for (
                        let page = start;
                        page <= end;
                        page++
                    ) {

                        const button =
                            document.createElement("button");

                        button.type =
                            "button";

                        button.className =
                            "history-page-btn"
                            + (
                                page === currentPage
                                    ? " active"
                                    : ""
                            );

                        button.textContent =
                            page.toString();

                        button.addEventListener(
                            "click",
                            function () {

                                currentPage =
                                    page;

                                renderOrders();

                                document
                                    .querySelector(".history-toolbar")
                                    ?.scrollIntoView({
                                        behavior: "smooth",
                                        block: "start"
                                    });
                            }
                        );

                        pagination.appendChild(
                            button
                        );
                    }


                    const next =
                        document.createElement("button");

                    next.type =
                        "button";

                    next.className =
                        "history-page-btn";

                    next.innerHTML =
                        '<i class="bi bi-chevron-right"></i>';

                    next.disabled =
                        currentPage === totalPages;

                    next.addEventListener(
                        "click",
                        function () {

                            if (
                                currentPage
                                < totalPages
                            ) {

                                currentPage++;

                                renderOrders();

                                document
                                    .querySelector(".history-toolbar")
                                    ?.scrollIntoView({
                                        behavior: "smooth",
                                        block: "start"
                                    });
                            }
                        }
                    );

                    pagination.appendChild(
                        next
                    );
                }


                function updateFilterHint() {

                    if (!filterHint) {
                        return;
                    }


                    const parts =
                        [];


                    if (
                        searchInput
                        && searchInput.value.trim()
                    ) {

                        parts.push(
                            `mã "${searchInput.value.trim()}"`
                        );
                    }


                    if (
                        statusFilter
                        && statusFilter.value !== "all"
                    ) {

                        parts.push(
                            statusFilter.value
                        );
                    }


                    if (
                        timeFilter
                        && timeFilter.value !== "all"
                    ) {

                        parts.push(
                            `${timeFilter.options[timeFilter.selectedIndex].text}`
                        );
                    }


                    filterHint.textContent =
                        parts.length
                            ? `Đang lọc: ${parts.join(" • ")}`
                            : "Hiển thị tất cả đơn hàng";
                }


                function renderOrders() {

                    const filtered =
                        getFilteredOrders();


                    const totalPages =
                        Math.max(
                            1,
                            Math.ceil(
                                filtered.length
                                / PAGE_SIZE
                            )
                        );


                    if (
                        currentPage
                        > totalPages
                    ) {

                        currentPage =
                            totalPages;
                    }


                    orderCards.forEach(
                        function (card) {

                            card.style.display =
                                "none";
                        }
                    );


                    const start =
                        (currentPage - 1)
                        * PAGE_SIZE;

                    const pageItems =
                        filtered.slice(
                            start,
                            start + PAGE_SIZE
                        );


                    pageItems.forEach(
                        function (card) {

                            card.style.display =
                                "";
                        }
                    );


                    if (resultCount) {

                        resultCount.textContent =
                            filtered.length.toString();
                    }


                    if (noResults) {

                        noResults.hidden =
                            filtered.length !== 0;
                    }


                    if (pagination) {

                        pagination.style.display =
                            filtered.length === 0
                                ? "none"
                                : "flex";
                    }


                    updateFilterHint();

                    renderPagination(
                        filtered.length === 0
                            ? 0
                            : totalPages
                    );
                }


                function filterChanged() {

                    currentPage =
                        1;

                    renderOrders();
                }


                searchInput?.addEventListener(
                    "input",
                    filterChanged
                );


                statusFilter?.addEventListener(
                    "change",
                    filterChanged
                );


                timeFilter?.addEventListener(
                    "change",
                    filterChanged
                );


                resetFilter?.addEventListener(
                    "click",
                    function () {

                        if (searchInput) {
                            searchInput.value = "";
                        }

                        if (statusFilter) {
                            statusFilter.value = "all";
                        }

                        if (timeFilter) {
                            timeFilter.value = "all";
                        }

                        currentPage =
                            1;

                        renderOrders();

                        searchInput?.focus();
                    }
                );


                renderOrders();

            }
        );

    </script>

}